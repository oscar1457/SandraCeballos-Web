{
  "name": "sandra-ceballos-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "test:browsers": "node tests/ensure-browsers.mjs",
    "test": "playwright test",
    "test:update-visual": "playwright test --project=visual --update-snapshots",
    "test:webkit": "WEBKIT=1 playwright test --project=webkit-desktop --project=webkit-mobile",
    "test:lighthouse": "node tests/lighthouse.mjs",
    "test:lighthouse:update": "node tests/lighthouse.mjs --update",
    "verify": "npm run check && npm run build && npm run test:browsers && npm test",
    "verify:full": "npm run verify && npm run test:lighthouse"
  },
  "dependencies": {
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource/dm-serif-display": "^5.3.0",
    "astro": "^7.1.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.56.1",
    "chrome-launcher": "1.2.2",
    "lighthouse": "12.8.2",
    "playwright-core": "1.56.1",
    "typescript": "^5.9.2"
  }
}
