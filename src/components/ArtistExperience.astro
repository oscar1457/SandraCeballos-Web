---
import { Image } from "astro:assets";
import ArtworkRail from "@/components/ArtworkRail.astro";
import ArtworkViewer from "@/components/ArtworkViewer.astro";
import CareerAccordion from "@/components/CareerAccordion.astro";
import LanguageSwitch from "@/components/LanguageSwitch.astro";
import type { Artwork } from "@/data/artworks";
import type { Site } from "@/data/site";

type Props = {
  site: Site;
  artworks: Artwork[];
};

const { site, artworks } = Astro.props;
const firstArtwork = artworks[0];
if (!firstArtwork) {
  throw new Error("ArtistExperience requiere al menos una obra.");
}
---

<section class="artist-stage" id="inicio" data-experience data-mode="home">
  <Image
    src={site.backgroundImage}
    alt=""
    widths={[720, 1080, 1440, 1920, 2400]}
    sizes="100vw"
    loading="eager"
    decoding="async"
    fetchpriority="high"
    aria-hidden="true"
    class="artist-stage__background"
  />
  <div class="artist-stage__veil" aria-hidden="true"></div>

  <div class="experience-surface" data-surface>
    <div class="experience-language">
      <LanguageSwitch />
    </div>

    <section class="experience-panel cover-panel" aria-label="Portada" data-aria-label-en="Cover" data-cover-panel>
      <ArtworkRail artworks={artworks} label="Obras destacadas" labelEn="Featured works" variant="cover" />

      <div class="cover-panel__middle">
        <p class="cover-panel__role">
          <span data-lang="es">{site.role}</span>
          <span data-lang="en">{site.roleEn}</span>
        </p>
        <nav class="cover-panel__nav" aria-label="Navegación principal" data-aria-label-en="Main navigation">
          <a
            class="cover-panel__button"
            href={`#obra/${firstArtwork.slug}`}
            data-open-gallery
            aria-controls="galeria-obras"
            aria-expanded="false"
          >
            <span data-lang="es">{site.nav.viewArtwork}</span>
            <span data-lang="en">{site.nav.viewArtworkEn}</span>
          </a>
          <a
            class="cover-panel__button"
            href="#esenciales"
            data-open-career
            data-career-target="essentials"
            aria-controls="trayectoria-panel"
            aria-expanded="false"
          >
            <span data-lang="es">{site.nav.essentials}</span>
            <span data-lang="en">{site.nav.essentialsEn}</span>
          </a>
          <a
            class="cover-panel__button"
            href="#trayectoria"
            data-open-career
            data-career-target="timeline"
            aria-controls="trayectoria-panel"
            aria-expanded="false"
          >
            <span data-lang="es">{site.nav.career}</span>
            <span data-lang="en">{site.nav.careerEn}</span>
          </a>
          <a class="cover-panel__button" href="#contacto">
            <span data-lang="es">{site.nav.contact}</span>
            <span data-lang="en">{site.nav.contactEn}</span>
          </a>
          <a
            class="cover-panel__button"
            href={site.portfolioPdf}
            target="_blank"
            rel="noreferrer"
          >
            <span data-lang="es">{site.nav.portfolio}</span>
            <span data-lang="en">{site.nav.portfolioEn}</span>
          </a>
        </nav>
      </div>

      <div class="cover-panel__bottom">
        <p aria-hidden="true">(01 / {String(artworks.length).padStart(2, "0")})</p>
      </div>

      <h1>{site.name}</h1>
    </section>

    <section
      class="experience-panel detail-panel"
      id="galeria-obras"
      aria-label="Galería de obras"
      data-aria-label-en="Artwork gallery"
      aria-hidden="true"
      data-gallery-panel-host
    >
      <ArtworkViewer artworks={artworks} site={site} />
    </section>

    <section
      class="experience-panel detail-panel"
      id="trayectoria-panel"
      aria-label="Trayectoria"
      data-aria-label-en="Career"
      aria-hidden="true"
      data-career-panel-host
    >
      <CareerAccordion site={site} />
    </section>
  </div>
</section>

<script>
  import "@/scripts/experience.ts";
  import "@/scripts/language.ts";
</script>

<style>
  .artist-stage {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 100svh;
    padding: clamp(1rem, 3vw, 3rem);
    isolation: isolate;
    overflow: hidden;
  }

  .artist-stage__background,
  .artist-stage__veil {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .artist-stage__background {
    z-index: -2;
    object-fit: cover;
  }

  .artist-stage__veil {
    z-index: -1;
    background: color-mix(in srgb, var(--color-ink) 18%, transparent);
  }

  .experience-surface {
    position: relative;
    width: min(92vw, 90rem);
    min-height: clamp(38rem, 80svh, 54rem);
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--color-ink) 24%, transparent);
    background: var(--color-paper);
  }

  .experience-language {
    position: absolute;
    top: clamp(0.85rem, 2vw, 1.5rem);
    right: clamp(0.85rem, 2vw, 1.5rem);
    z-index: 4;
  }

  .experience-panel {
    position: absolute;
    inset: 0;
    padding: clamp(0.85rem, 2vw, 1.5rem);
    background: var(--color-paper);
    min-width: 0;
    transition:
      transform var(--duration-main) var(--ease-editorial),
      opacity var(--duration-main) var(--ease-editorial);
    will-change: transform, opacity;
  }

  .cover-panel {
    display: grid;
    grid-template-rows: auto minmax(9rem, 1fr) auto auto;
    gap: clamp(1rem, 2.5vw, 2rem);
    transform: translateX(0);
  }

  [data-mode="gallery"] .cover-panel,
  [data-mode="career"] .cover-panel {
    transform: translateX(-102%);
    opacity: 0.92;
  }

  .detail-panel {
    transform: translateX(102%);
    opacity: 0.98;
  }

  [data-mode="gallery"] [data-gallery-panel-host],
  [data-mode="career"] [data-career-panel-host] {
    transform: translateX(0);
    opacity: 1;
  }

  [data-mode="gallery"] [data-career-panel-host],
  [data-mode="career"] [data-gallery-panel-host] {
    transform: translateX(102%);
    opacity: 0;
  }

  .cover-panel__middle {
    display: grid;
    grid-template-columns: minmax(10rem, 0.85fr) minmax(10rem, 1fr);
    gap: var(--space-4);
    align-items: center;
  }

  .cover-panel__role {
    max-width: 18rem;
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(1.35rem, 2.2vw, 2rem);
    line-height: 1.05;
  }

  .cover-panel__nav {
    display: grid;
    grid-template-columns: repeat(2, minmax(8.5rem, 1fr));
    gap: var(--space-1);
    width: min(100%, 30rem);
  }

  .cover-panel__nav a,
  .cover-panel__bottom a {
    color: inherit;
    text-decoration: none;
  }

  .cover-panel__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-width: 0;
    width: 100%;
    min-height: 2.75rem;
    padding: 0 0.75rem;
    border: 1px solid var(--color-ink);
    color: var(--color-ink);
    font-size: var(--text-label);
    font-weight: 800;
    text-transform: uppercase;
    transition:
      background-color 160ms ease,
      color 160ms ease;
  }

  .cover-panel__button > span:not([aria-hidden="true"]) {
    min-width: 0;
  }

  .cover-panel__button:hover,
  .cover-panel__button:focus-visible {
    background: var(--color-ink);
    color: var(--color-paper) !important;
    text-decoration: none !important;
  }

  .cover-panel__button:hover *,
  .cover-panel__button:focus-visible * {
    color: var(--color-paper) !important;
  }

  .cover-panel__bottom a:hover {
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .cover-panel__bottom {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-2);
    font-size: var(--text-label);
    font-weight: 700;
    text-transform: uppercase;
  }

  .cover-panel__bottom p {
    margin: 0;
  }

  .cover-panel h1 {
    max-width: 100%;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(4.2rem, 11.6vw, 12.25rem);
    line-height: 0.82;
    letter-spacing: 0;
    text-transform: uppercase;
    overflow-wrap: normal;
    word-break: normal;
    text-wrap: balance;
  }

  @media (max-width: 980px) {
    .experience-surface {
      width: min(94vw, 58rem);
      min-height: min(50rem, calc(100svh - 2rem));
    }

    .detail-panel {
      overflow-y: auto;
    }

    [data-career-panel-host] {
      scrollbar-width: none;
      -ms-overflow-style: none;
    }

    [data-career-panel-host]::-webkit-scrollbar {
      width: 0;
      height: 0;
      display: none;
    }

    .cover-panel__middle {
      grid-template-columns: 1fr;
      align-content: center;
      gap: var(--space-3);
    }

    .cover-panel__nav {
      width: 100%;
      max-width: 34rem;
    }

    .cover-panel h1 {
      font-size: clamp(4rem, 14vw, 8rem);
      line-height: 0.84;
    }
  }

  @media (min-width: 1180px) {
    .cover-panel__nav {
      grid-template-columns: repeat(5, minmax(6.8rem, 1fr));
      width: min(100%, 50rem);
    }
  }

  @media (max-width: 760px) {
    .artist-stage {
      align-items: start;
      min-height: 100svh;
      padding: 0.75rem;
    }

    .experience-surface {
      width: 100%;
      min-height: calc(100svh - 1.5rem);
    }

    .experience-panel {
      overflow-y: auto;
      padding: var(--space-2);
      padding-top: 4.25rem;
    }

    .cover-panel {
      grid-template-rows: auto minmax(10rem, 1fr) auto auto;
    }

    .cover-panel__middle {
      grid-template-columns: 1fr;
      align-content: center;
      gap: var(--space-3);
    }

    .cover-panel__nav {
      width: 100%;
    }

    .cover-panel__button {
      min-height: 3rem;
    }

    .cover-panel__role {
      max-width: 14rem;
    }

    .cover-panel h1 {
      font-size: clamp(3.3rem, 17vw, 5.8rem);
      line-height: 0.88;
    }
  }

  @media (max-width: 520px) {
    .cover-panel__nav {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .experience-panel {
      transition-duration: 80ms;
    }

    [data-mode="gallery"] .cover-panel,
    [data-mode="career"] .cover-panel,
    .detail-panel,
    [data-mode="gallery"] [data-gallery-panel-host],
    [data-mode="career"] [data-career-panel-host] {
      transform: none;
    }

    .detail-panel {
      opacity: 0;
      pointer-events: none;
    }

    [data-mode="gallery"] [data-gallery-panel-host],
    [data-mode="career"] [data-career-panel-host] {
      opacity: 1;
      pointer-events: auto;
    }
  }
</style>
