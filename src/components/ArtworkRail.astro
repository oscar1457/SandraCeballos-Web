---
import { Image } from "astro:assets";
import type { Artwork } from "@/data/artworks";

type Props = {
  artworks: Artwork[];
  label: string;
  variant?: "cover" | "gallery";
};

const { artworks, label, variant = "cover" } = Astro.props;
---

<nav
  class:list={["artwork-rail", `artwork-rail--${variant}`]}
  aria-label={label}
  data-cover-rail={variant === "cover" ? "" : undefined}
>
  <ol class="artwork-rail__list">
    {
      artworks.map((artwork, index) => (
        <li class="artwork-rail__item">
          <a
            class="artwork-rail__link"
            href={`#obra/${artwork.slug}`}
            data-artwork-link
            data-cover-preview-link={variant === "cover" ? "" : undefined}
            data-preview-current={variant === "cover" && index === 0 ? "true" : undefined}
            data-index={index}
            aria-label={`${index + 1}. ${artwork.title}`}
          >
            <span class="artwork-rail__number" aria-hidden="true">
              {String(index + 1).padStart(2, "0")}
            </span>
            <span class="artwork-rail__frame">
              <Image
                src={artwork.thumbnail}
                alt=""
                width={variant === "cover" ? 132 : 112}
                height={variant === "cover" ? 96 : 84}
                loading={index < 5 ? "eager" : "lazy"}
                decoding="async"
                class="artwork-rail__image"
              />
            </span>
          </a>
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .artwork-rail {
    min-width: 0;
  }

  .artwork-rail__list {
    display: flex;
    gap: var(--space-2);
    margin: 0;
    padding: 0 0 var(--space-2);
    list-style: none;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .artwork-rail__list::-webkit-scrollbar {
    width: 0;
    height: 0;
    display: none;
  }

  .artwork-rail__item {
    flex: 0 0 auto;
    scroll-snap-align: start;
  }

  .artwork-rail__link {
    display: grid;
    grid-template-rows: auto 1fr;
    gap: 0.35rem;
    min-width: 5rem;
    color: inherit;
    text-decoration: none;
  }

  .artwork-rail__number {
    font-size: var(--text-label);
    line-height: 1;
    font-weight: 700;
    letter-spacing: 0;
  }

  .artwork-rail__frame {
    display: block;
    aspect-ratio: 4 / 3;
    width: clamp(4.75rem, 8vw, 8.25rem);
    border: 1px solid transparent;
    background: var(--color-paper-muted);
    overflow: hidden;
  }

  .artwork-rail--gallery .artwork-rail__frame {
    width: clamp(4.25rem, 7vw, 7rem);
  }

  .artwork-rail__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
      opacity var(--duration-short) var(--ease-editorial),
      transform var(--duration-short) var(--ease-editorial);
  }

  .artwork-rail--cover .artwork-rail__link {
    opacity: 0.58;
    transition: opacity var(--duration-short) var(--ease-editorial);
  }

  .artwork-rail--cover .artwork-rail__link:hover,
  .artwork-rail--cover .artwork-rail__link:focus-visible,
  .artwork-rail--cover .artwork-rail__link[data-preview-current="true"] {
    opacity: 1;
  }

  .artwork-rail__link:hover .artwork-rail__frame,
  .artwork-rail__link[aria-current="true"] .artwork-rail__frame,
  .artwork-rail__link[data-preview-current="true"] .artwork-rail__frame {
    border-color: var(--color-ink);
  }

  .artwork-rail--cover .artwork-rail__link[data-preview-current="true"] .artwork-rail__image {
    transform: scale(1.035);
  }

  .artwork-rail__link[aria-current="true"] .artwork-rail__number,
  .artwork-rail__link[data-preview-current="true"] .artwork-rail__number {
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  @media (max-width: 720px) {
    .artwork-rail__list {
      gap: var(--space-1);
      scroll-snap-type: x mandatory;
    }

    .artwork-rail__link {
      min-width: 4.75rem;
    }
  }
</style>
