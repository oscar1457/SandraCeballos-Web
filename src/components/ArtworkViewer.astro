---
import { Image } from "astro:assets";
import ArtworkRail from "@/components/ArtworkRail.astro";
import type { Artwork } from "@/data/artworks";
import type { Site } from "@/data/site";

type Props = {
  artworks: Artwork[];
  site: Site;
};

const { artworks, site } = Astro.props;
---

<section class="gallery-view" aria-labelledby="gallery-title" data-gallery-view>
  <div class="gallery-view__topline">
    <button class="text-button" type="button" data-close-panel>
      <span data-lang="es">{site.nav.closeGallery}</span>
      <span data-lang="en">{site.nav.closeGalleryEn}</span>
    </button>
    <p class="gallery-view__count" data-artwork-counter aria-live="polite">
      01/{String(artworks.length).padStart(2, "0")}
    </p>
  </div>

  <div class="gallery-view__slides">
    {
      artworks.map((artwork, index) => (
        <article
          class:list={["gallery-view__slide", index === 0 && "is-active"]}
          id={`artwork-${artwork.slug}`}
          data-artwork-panel
          data-index={index}
          aria-hidden={index === 0 ? "false" : "true"}
        >
          <figure class="gallery-view__figure">
            <Image
              src={artwork.image}
              alt={artwork.alt}
              widths={[420, 720, 960, 1280, 1600]}
              sizes="(max-width: 760px) 88vw, 50vw"
              loading="lazy"
              decoding="async"
              class="gallery-view__image"
            />
          </figure>
          <div class="gallery-view__meta">
            <p class="gallery-view__eyebrow">
              <span data-lang="es">Obra</span>
              <span data-lang="en">Work</span>
              {" "}
              {String(index + 1).padStart(2, "0")}
            </p>
            <h2 id={index === 0 ? "gallery-title" : undefined} tabindex="-1" data-artwork-heading>
              {artwork.title}
            </h2>
            <dl>
              <div>
                <dt><span data-lang="es">Año</span><span data-lang="en">Year</span></dt>
                <dd>{artwork.year}</dd>
              </div>
              <div>
                <dt><span data-lang="es">Técnica</span><span data-lang="en">Medium</span></dt>
                <dd>
                  <span data-lang="es">{artwork.technique}</span>
                  <span data-lang="en">{artwork.techniqueEn}</span>
                </dd>
              </div>
              <div>
                <dt><span data-lang="es">Dimensiones</span><span data-lang="en">Dimensions</span></dt>
                <dd>{artwork.dimensions}</dd>
              </div>
            </dl>
            <p>
              <span data-lang="es">{artwork.description}</span>
              <span data-lang="en">{artwork.descriptionEn}</span>
            </p>
          </div>
        </article>
      ))
    }
  </div>

  <div class="gallery-view__controls" aria-label="Controles de galería">
    <button class="nav-button" type="button" data-gallery-prev aria-label={site.nav.previous}>
      <span aria-hidden="true">←</span>
    </button>
    <button class="nav-button" type="button" data-gallery-next aria-label={site.nav.next}>
      <span aria-hidden="true">→</span>
    </button>
  </div>

  <ArtworkRail artworks={artworks} label="Seleccionar obra en galería" variant="gallery" />
</section>

<style>
	  .gallery-view {
	    display: grid;
	    grid-template-rows: auto minmax(0, 1fr) auto;
	    gap: clamp(0.75rem, 1.2vw, 1.15rem);
	    min-height: 100%;
	  }

  .gallery-view__topline,
  .gallery-view__controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .gallery-view__count,
  .gallery-view__eyebrow {
    margin: 0;
    font-size: var(--text-label);
    font-weight: 700;
    line-height: 1;
    text-transform: uppercase;
  }

	  .gallery-view__slides {
	    position: relative;
	    min-height: min(31rem, 52svh);
	    overflow: hidden;
	  }

  .gallery-view__slide {
	    position: absolute;
	    inset: 0;
	    display: grid;
	    grid-template-columns: minmax(15rem, 0.44fr) minmax(0, 1fr);
	    grid-template-areas: "meta image";
	    gap: clamp(2rem, 4.5vw, 4.5rem);
	    align-items: stretch;
    opacity: 0;
    transform: translateX(1.4rem);
    pointer-events: none;
    transition:
      opacity var(--duration-short) var(--ease-editorial),
      transform var(--duration-short) var(--ease-editorial);
  }

  .gallery-view__slide.is-active {
    opacity: 1;
    transform: translateX(0);
    pointer-events: auto;
  }

	  .gallery-view__figure {
	    grid-area: image;
	    position: relative;
	    display: grid;
	    place-items: center;
	    width: 100%;
	    height: 100%;
	    min-width: 0;
	    min-height: 0;
	    margin: 0;
	    overflow: visible;
	    background: var(--color-paper-muted);
	    border: 1px solid var(--color-line);
	  }

	  .gallery-view__figure :global(picture) {
	    display: grid;
	    place-items: center;
	    width: 100%;
	    height: 100%;
	  }

	  .gallery-view__figure :global(img),
	  .gallery-view__image {
	    position: absolute;
	    inset: 0;
	    width: 100% !important;
	    height: 100% !important;
	    max-width: 100%;
	    max-height: 100%;
	    object-fit: contain;
	  }

  .gallery-view__meta {
    grid-area: meta;
    align-self: start;
    display: grid;
    gap: clamp(0.85rem, 1.4vw, 1.35rem);
	    max-width: 25rem;
	    max-height: 100%;
    min-width: 0;
    overflow-y: auto;
    padding-right: 0.35rem;
  }

  .gallery-view__meta h2 {
	    max-width: 13ch;
	    margin: 0;
	    font-family: var(--font-display);
	    font-size: clamp(2rem, 2.8vw, 3.25rem);
    line-height: 0.92;
    letter-spacing: 0;
    text-transform: uppercase;
    overflow-wrap: break-word;
  }

  .gallery-view__meta dl {
    display: grid;
    gap: var(--space-1);
    margin: 0;
    font-size: var(--text-small);
  }

  .gallery-view__meta dl div {
    display: grid;
    grid-template-columns: minmax(6.5rem, 0.34fr) 1fr;
    gap: var(--space-2);
    border-top: 1px solid var(--color-line);
    padding-top: 0.45rem;
  }

  .gallery-view__meta dt {
    font-size: var(--text-label);
    font-weight: 700;
    text-transform: uppercase;
  }

  .gallery-view__meta dd {
    margin: 0;
  }

  .gallery-view__meta p:last-child {
    max-width: 30rem;
    margin: 0;
    font-size: var(--text-small);
  }

	  .gallery-view__controls {
	    justify-content: space-between;
	  }

	  .gallery-view > .artwork-rail {
	    min-width: 0;
	  }

  .nav-button {
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    min-width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--color-ink);
    background: transparent;
    color: var(--color-ink);
    font: inherit;
    cursor: pointer;
  }

  .nav-button:hover {
    background: var(--color-ink);
    color: var(--color-paper);
  }

  @media (max-width: 1080px) {
    .gallery-view__slide {
      grid-template-columns: minmax(13rem, 0.38fr) minmax(0, 1fr);
      gap: var(--space-3);
    }

    .gallery-view__meta h2 {
      font-size: clamp(1.9rem, 3.8vw, 3rem);
    }
  }

  @media (max-width: 860px) {
    .gallery-view {
      gap: var(--space-2);
    }

    .gallery-view__slides {
      height: auto;
      min-height: 0;
      overflow: visible;
    }

    .gallery-view__slide {
      position: static;
      display: none;
      grid-template-columns: 1fr;
      grid-template-areas:
        "image"
        "meta";
      gap: var(--space-3);
      transform: none;
    }

    .gallery-view__slide.is-active {
      display: grid;
    }

	    .gallery-view__figure {
	      min-height: clamp(15rem, 48svh, 24rem);
	      max-height: 48svh;
	      aspect-ratio: 4 / 5;
	    }

	    .gallery-view__figure :global(img),
	    .gallery-view__image {
	      width: 100%;
	      height: 100%;
	      max-width: 100%;
	      max-height: 100%;
	    }

    .gallery-view__meta {
      align-self: start;
      max-height: none;
      overflow: visible;
      gap: var(--space-2);
    }

	    .gallery-view__meta h2 {
	      max-width: 100%;
	      font-size: clamp(2rem, 9vw, 3.35rem);
	      line-height: 0.96;
	      text-wrap: balance;
	    }

    .gallery-view__meta dl div {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }
  }
</style>
