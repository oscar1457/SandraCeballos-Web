---
import { Image } from "astro:assets";
import { careerPanels, careerStages, essentialHighlights } from "@/data/exhibitions";
import portrait from "@/assets/sandra-ceballos-retrato.jpg";

const cvPanels = careerPanels.filter((panel) => panel.id !== "biografia");
const place = (...parts: string[]) => parts.filter(Boolean).join(", ");
---

<section class="career" id="trayectoria" data-header="dark" aria-labelledby="career-title">
  <div class="career__letter" aria-hidden="true" data-career-letter>C<canvas class="career__letter-video" data-career-letter-video></canvas></div>

  <h2 class="career__statement" id="career-title">
    <span data-lang="es">
      Pintura, curaduría independiente y archivo: una práctica unida a la historia de Espacio
      Aglutinador desde 1994.
    </span>
    <span data-lang="en">
      Painting, independent curating and archive: a practice tied to the history of Espacio
      Aglutinador since 1994.
    </span>
  </h2>

  <!-- Retrato en blanco y negro; solo se conserva el rojo de la bolsa. -->
  <figure class="career__portrait" data-career-portrait>
    <Image
      src={portrait}
      alt="Retrato de Sandra Ceballos en una galería, con gafas de sol y una bolsa de tela con una cara y una raya roja."
      widths={[420, 700, 1000]}
      sizes="(max-width: 900px) 70vw, 22rem"
      loading="lazy"
    />
    <figcaption>Sandra Ceballos</figcaption>
  </figure>

  <div class="career__index">
    <p class="career__lead">
      <span data-lang="es">Trayectoria, hitos y currículum. Pulsa cada apartado para abrirlo.</span>
      <span data-lang="en">Career, highlights and CV. Select each section to open it.</span>
    </p>

    <details class="career__item">
      <summary>
        <span class="num">(1)</span>
        <span><span data-lang="es">Cronología</span><span data-lang="en">Timeline</span></span>
      </summary>
      <ol class="rows">
        {
          careerStages.map((stage, index) => (
            <li class="row" style={`--row:${index}`}>
              <span class="num">{stage.year}</span>
              <span>
                <strong>
                  <span data-lang="es">{stage.title}</span>
                  <span data-lang="en">{stage.titleEn}</span>
                </strong>
                <span class="row__note">
                  <span data-lang="es">{stage.summary}</span>
                  <span data-lang="en">{stage.summaryEn}</span>
                </span>
              </span>
            </li>
          ))
        }
      </ol>
    </details>

    <details class="career__item">
      <summary>
        <span class="num">(2)</span>
        <span><span data-lang="es">Hitos</span><span data-lang="en">Highlights</span></span>
      </summary>
      <ul class="rows">
        {
          essentialHighlights.map((item, index) => (
            <li class="row" style={`--row:${index}`}>
              <span class="num">{item.year || "—"}</span>
              <span>
                <strong>
                  {item.url ? (
                    <a href={item.url} target="_blank" rel="noreferrer">
                      <span data-lang="es">{item.title}</span>
                      <span data-lang="en">{item.titleEn}</span>
                    </a>
                  ) : (
                    <>
                      <span data-lang="es">{item.title}</span>
                      <span data-lang="en">{item.titleEn}</span>
                    </>
                  )}
                </strong>
                <span class="row__note">
                  {place(item.city, item.country)}.{" "}
                  <span data-lang="es">{item.summary}</span>
                  <span data-lang="en">{item.summaryEn}</span>
                </span>
              </span>
            </li>
          ))
        }
      </ul>
    </details>

    {
      cvPanels.map((panel, index) => (
        <details class="career__item">
          <summary>
            <span class="num">({index + 3})</span>
            <span>
              <span data-lang="es">{panel.label}</span>
              <span data-lang="en">{panel.labelEn}</span>
            </span>
          </summary>
          <ul class="rows">
            {panel.items.map((item, index) => (
              <li class="row" style={`--row:${index}`}>
                <span class="num">{item.year || "—"}</span>
                <span>
                  <strong>
                    {item.url ? (
                      <a href={item.url} target="_blank" rel="noreferrer">{item.title}</a>
                    ) : (
                      item.title
                    )}
                  </strong>
                  <span class="row__note">{place(item.venue, item.city, item.country)}</span>
                </span>
              </li>
            ))}
          </ul>
        </details>
      ))
    }
  </div>
</section>

<script>
  // Animaciones de Trayectoria:
  // 1. Al llegar con el scroll: la frase aparece palabra a palabra, la C crece
  //    y gira, y los apartados entran uno tras otro.
  // 2. Al pulsar un apartado: se abre y se cierra deslizándose.
  // 3. Con ratón: la C sigue suavemente al cursor.
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  // Separa la frase en palabras para animarlas una a una. No mide el texto,
  // así funciona también con el idioma que está oculto.
  const splitWords = (element: HTMLElement) => {
    const words = (element.textContent ?? "").trim().split(/\s+/);
    element.textContent = "";
    return words.map((word, index) => {
      const inner = document.createElement("span");
      inner.className = "word";
      inner.textContent = word;
      element.append(inner);
      if (index < words.length - 1) {
        // El espacio va en su propio <span>: GSAP, al medir la frase del idioma
        // oculto, recoloca cada palabra antes del siguiente elemento y movía los
        // espacios sueltos (salía «since1994»).
        const space = document.createElement("span");
        space.className = "space";
        space.textContent = " ";
        element.append(space);
      }
      return inner;
    });
  };

  const section = document.getElementById("trayectoria");
  const letter = document.querySelector<HTMLElement>("[data-career-letter]");
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const canHover = window.matchMedia("(hover: hover) and (pointer: fine)").matches;

  if (section && letter && !reduced) {

    // 1a. Frase grande, palabra a palabra.
    section.querySelectorAll<HTMLElement>(".career__statement > span").forEach((span) => {
      const words = splitWords(span);
      gsap.from(words, {
        yPercent: 70,
        opacity: 0,
        duration: 0.9,
        ease: "power3.out",
        stagger: 0.04,
        clearProps: "transform,opacity",
        scrollTrigger: { trigger: section, start: "top 70%" }
      });
    });

    // 1b. La C crece y gira mientras se entra en la sección.
    gsap.fromTo(
      letter,
      { scale: 0.85, rotate: -8, opacity: 0 },
      {
        scale: 1,
        rotate: 0,
        opacity: 1,
        ease: "none",
        scrollTrigger: { trigger: section, start: "top bottom", end: "top 15%", scrub: 0.8 }
      }
    );

    // 1b'. El retrato se descubre de abajo arriba al llegar.
    const portraitFigure = section.querySelector<HTMLElement>("[data-career-portrait]");
    if (portraitFigure) {
      gsap.fromTo(
        portraitFigure,
        { clipPath: "inset(100% 0% 0% 0%)" },
        {
          clipPath: "inset(0% 0% 0% 0%)",
          duration: 1.2,
          ease: "power3.inOut",
          clearProps: "clipPath",
          scrollTrigger: { trigger: portraitFigure, start: "top 85%" }
        }
      );
    }

    // 1c. Texto de entrada y apartados, uno tras otro.
    const entries = section.querySelectorAll(".career__lead, .career__item");
    gsap.from(entries, {
      y: 40,
      opacity: 0,
      duration: 0.8,
      ease: "power3.out",
      stagger: 0.07,
      scrollTrigger: { trigger: ".career__index", start: "top 85%" }
    });

    // 3. La C sigue al ratón.
    if (canHover) {
      const moveX = gsap.quickTo(letter, "x", { duration: 1.2, ease: "power3.out" });
      const moveY = gsap.quickTo(letter, "y", { duration: 1.2, ease: "power3.out" });
      section.addEventListener("pointermove", (event) => {
        const rect = section.getBoundingClientRect();
        moveX(((event.clientX - rect.left) / rect.width - 0.5) * 50);
        moveY(((event.clientY - rect.top) / rect.height - 0.5) * 30);
      });
      section.addEventListener("pointerleave", () => {
        moveX(0);
        moveY(0);
      });
    }
  }

  // 2. Abrir y cerrar apartados con movimiento (sin movimiento reducido: instantáneo).
  if (section && !reduced) {
    section.querySelectorAll<HTMLDetailsElement>(".career__item").forEach((item) => {
      const summary = item.querySelector("summary");
      const content = item.querySelector<HTMLElement>(".rows");
      if (!summary || !content) {
        return;
      }
      // "expanded" guarda lo que el usuario quiere (abierto o cerrado), aunque
      // la animación anterior no haya terminado: así varios clics seguidos
      // siempre acaban en un estado correcto.
      let expanded = item.open;
      const fullPadding = () => {
        content.style.removeProperty("padding-bottom");
        const value = getComputedStyle(content).paddingBottom;
        return value;
      };
      summary.addEventListener("click", (event) => {
        event.preventDefault();
        expanded = !expanded;
        gsap.killTweensOf(content);
        if (expanded) {
          const from = item.open ? content.getBoundingClientRect().height : 0;
          const paddingBottom = fullPadding();
          item.open = true;
          gsap.fromTo(
            content,
            { height: from, paddingBottom: from === 0 ? 0 : paddingBottom, overflow: "hidden" },
            {
              height: "auto",
              paddingBottom,
              duration: 0.7,
              ease: "power3.inOut",
              onComplete: () => gsap.set(content, { clearProps: "height,paddingBottom,overflow" })
            }
          );
        } else {
          gsap.to(content, {
            height: 0,
            paddingBottom: 0,
            overflow: "hidden",
            duration: 0.5,
            ease: "power3.inOut",
            onComplete: () => {
              if (!expanded) {
                item.open = false;
              }
              gsap.set(content, { clearProps: "height,paddingBottom,overflow" });
            }
          });
        }
      });
    });
  }
</script>

<script>
  // Dentro de la C: el vídeo de Sandra pintando, en trama de imprenta y con
  // el color de la letra. El WebGL y el vídeo solo se cargan al acercarse;
  // la C de texto sigue debajo, así que sin WebGL todo se ve igual que antes.
  import { attachSources, createHalftone, type Halftone } from "@/scripts/halftone";

  const letter = document.querySelector<HTMLElement>("[data-career-letter]");
  const canvas = letter?.querySelector<HTMLCanvasElement>("[data-career-letter-video]");
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const BASE = "/video/guia-espiritual-9-proceso";

  if (letter && canvas) {
    let halftone: Halftone | null = null;
    let tried = false;
    let visible = false;
    let frame = 0;
    let lastTime = -1;
    let gotVideo = false;
    const video = document.createElement("video");
    video.muted = true;
    video.loop = true;
    video.playsInline = true;
    video.preload = "auto";

    // Coloca el lienzo justo sobre el dibujo de la letra y lo recorta con su
    // forma (una máscara hecha con la misma fuente).
    const fit = () => {
      const style = getComputedStyle(letter);
      const size = parseFloat(style.fontSize);
      const lineHeight = parseFloat(style.lineHeight);
      const ctx = document.createElement("canvas").getContext("2d");
      if (!ctx || !size) return false;
      const font = `${style.fontStyle} ${style.fontWeight} ${size}px ${style.fontFamily}`;
      ctx.font = font;
      const m = ctx.measureText("C");
      const baseline = (lineHeight - (m.fontBoundingBoxAscent + m.fontBoundingBoxDescent)) / 2 + m.fontBoundingBoxAscent;
      const pad = 2;
      const left = -m.actualBoundingBoxLeft - pad;
      const top = baseline - m.actualBoundingBoxAscent - pad;
      const width = m.actualBoundingBoxLeft + m.actualBoundingBoxRight + pad * 2;
      const height = m.actualBoundingBoxAscent + m.actualBoundingBoxDescent + pad * 2;
      Object.assign(canvas.style, { left: `${left}px`, top: `${top}px`, width: `${width}px`, height: `${height}px` });

      const mask = document.createElement("canvas");
      const scale = Math.min(window.devicePixelRatio || 1, 2);
      mask.width = Math.ceil(width * scale);
      mask.height = Math.ceil(height * scale);
      const mctx = mask.getContext("2d");
      if (!mctx) return false;
      mctx.scale(scale, scale);
      mctx.font = font;
      mctx.fillStyle = "#000";
      mctx.textBaseline = "alphabetic";
      mctx.fillText("C", -left, baseline - top);
      const url = `url(${mask.toDataURL("image/png")})`;
      canvas.style.setProperty("mask-image", url);
      canvas.style.setProperty("-webkit-mask-image", url);
      return true;
    };

    const loop = () => {
      frame = 0;
      if (!visible || !halftone) return;
      if (video.readyState >= 2 && video.currentTime !== lastTime) {
        lastTime = video.currentTime;
        gotVideo = true;
        halftone.upload(video, video.videoWidth, video.videoHeight);
        halftone.draw();
      }
      frame = requestAnimationFrame(loop);
    };

    const init = async () => {
      if (tried) return;
      tried = true;
      await document.fonts.ready;
      if (!fit()) return;
      // Papel del color de la C y puntos un poco más oscuros: se lee como la
      // misma letra, con la imagen grabada dentro.
      halftone = createHalftone(canvas, {
        paper: [161, 159, 151],
        ink: [112, 109, 101],
        cell: (width) => Math.max(5, width / 90),
        dotScale: 0.6,
        minDot: 0.04,
        contrast: 1.25
      });
      const current = halftone;
      if (!current) return;
      const poster = new Image();
      poster.onload = () => {
        if (!gotVideo) current.upload(poster, poster.naturalWidth, poster.naturalHeight);
        current.resize();
        current.draw();
        letter.classList.add("has-video");
      };
      poster.src = `${BASE}.jpg`;
      let width = window.innerWidth;
      new ResizeObserver(() => {
        if (window.innerWidth !== width) {
          width = window.innerWidth;
          fit();
        }
        current.resize();
        current.draw();
      }).observe(canvas);
      if (!reduced) attachSources(video, BASE);
      if (visible) play();
    };

    const play = () => {
      if (!halftone || reduced) return;
      video.play().catch(() => {});
      if (!frame) frame = requestAnimationFrame(loop);
    };

    new IntersectionObserver(
      (entries) => {
        if (entries.some((entry) => entry.isIntersecting)) void init();
      },
      { rootMargin: "100% 0px" }
    ).observe(letter);

    new IntersectionObserver((entries) => {
      visible = entries.some((entry) => entry.isIntersecting);
      if (visible) play();
      else video.pause();
    }).observe(letter);
  }
</script>

<style>
  .career {
    position: relative;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    align-content: start;
    gap: var(--space-5) var(--gutter);
    min-height: 100svh;
    padding: 9rem var(--gutter) var(--space-5);
    overflow: hidden;
    background: var(--white);
    color: var(--black);
  }

  /* La C se coloca respecto a la parte de arriba de la sección (no al centro),
     así no se mueve cuando se abren apartados, y cabe entera en pantalla. */
  .career__letter {
    position: absolute;
    top: 52svh;
    left: 50%;
    translate: -50% -50%;
    color: var(--stone);
    font-family: var(--font-serif);
    font-size: min(108svh, 76vw);
    line-height: 0.72;
    pointer-events: none;
  }

  /* Lienzo con el vídeo en trama, recortado con la forma de la C. Aparece
     cuando ya tiene imagen; debajo sigue la C de texto. */
  .career__letter-video {
    position: absolute;
    display: block;
    opacity: 0;
    transition: opacity 900ms var(--ease);
    mask-size: 100% 100%;
    -webkit-mask-size: 100% 100%;
    mask-repeat: no-repeat;
    -webkit-mask-repeat: no-repeat;
  }

  .career__letter.has-video .career__letter-video {
    opacity: 1;
  }

  .career__statement {
    position: relative;
    grid-column: 1 / -1;
    margin: 0;
    font-size: clamp(2.2rem, 4.6vw, 5.2rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.04em;
    text-indent: 25%;
  }

  /* Cada palabra es un bloque propio para animarla; sin la sangría del párrafo. */
  .career__statement :global(.word) {
    display: inline-block;
    text-indent: 0;
  }

  .career__index {
    position: relative;
    grid-row: 2;
    grid-column: 7 / span 6;
  }

  /* En pantallas anchas los apartados dejan margen a la derecha. */
  @media (min-width: 1200px) {
    .career__index {
      grid-column: 7 / span 5;
    }
  }

  /* Retrato a la izquierda de los apartados, por delante de la C. */
  .career__portrait {
    position: relative;
    grid-row: 2;
    grid-column: 1 / span 4;
    align-self: start;
    max-width: 22rem;
    margin: 0;
  }

  .career__portrait img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1366 / 2048;
    object-fit: cover;
  }

  .career__portrait figcaption {
    margin-top: var(--space-1);
    color: var(--color-muted);
    font-size: var(--text-label);
    font-weight: 500;
  }

  .career__lead {
    margin: 0 0 var(--space-4);
    max-width: 28rem;
    font-size: clamp(1.1rem, 1.5vw, 1.4rem);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .career__item {
    border-bottom: 1px solid var(--black);
  }

  .career__item:first-of-type {
    border-top: 1px solid var(--black);
  }

  .career__item summary {
    position: relative;
    display: grid;
    grid-template-columns: 6rem 1fr auto;
    padding: 0.55rem 0;
    font-size: var(--text-small);
    font-weight: 600;
    list-style: none;
    cursor: pointer;
    isolation: isolate;
    transition: color 350ms var(--ease);
  }

  /* Al pasar el cursor: una franja negra entra desde la izquierda. */
  .career__item summary::before {
    content: "";
    position: absolute;
    inset: 0 calc(-1 * var(--gutter) / 2);
    z-index: -1;
    background: var(--black);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 450ms var(--ease);
  }

  .career__item summary > span {
    transition: transform 450ms var(--ease);
  }

  @media (hover: hover) {
    .career__item summary:hover {
      color: var(--white);
    }

    .career__item summary:hover::before {
      transform: scaleX(1);
      transform-origin: left;
    }

    .career__item summary:hover > span:nth-child(2) {
      transform: translateX(0.6rem);
    }
  }

  .career__item summary:focus-visible {
    outline-offset: -2px;
  }

  .career__item summary::-webkit-details-marker {
    display: none;
  }

  .career__item summary::after {
    content: "+";
    grid-column: 3;
    transition: transform 450ms var(--ease);
  }

  @media (hover: hover) {
    .career__item summary:hover::after {
      transform: rotate(90deg);
    }
  }

  .career__item[open] summary::after {
    content: "–";
  }

  /* El contenido abierto lleva fondo blanco para que el texto gris se lea bien
     aunque pase por encima de la C. Los títulos (1)–(6) son transparentes. */
  .rows {
    margin: 0;
    padding: 0 0 var(--space-2);
    list-style: none;
    background: var(--white);
  }

  .row {
    position: relative;
    display: grid;
    grid-template-columns: 6rem minmax(0, 1fr);
    padding: 0.45rem 0;
    border-top: 1px solid var(--color-line);
    font-size: var(--text-small);
    font-weight: 500;
    isolation: isolate;
  }

  /* Filas del contenido: una línea roja crece bajo la fila y el texto se desplaza. */
  .row::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 2px;
    background: var(--red);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 500ms var(--ease);
  }

  .row > span {
    transition:
      transform 450ms var(--ease),
      color 300ms var(--ease);
  }

  @media (hover: hover) {
    .row:hover::after {
      transform: scaleX(1);
    }

    .row:hover > span:first-child {
      color: var(--red);
    }

    .row:hover > span:last-child {
      transform: translateX(0.6rem);
    }
  }

  .row a {
    display: inline-block;
    padding-block: 0.25rem;
    margin-block: -0.25rem;
    text-decoration-color: transparent;
    transition: text-decoration-color 300ms var(--ease);
  }

  .row a:hover {
    text-decoration-color: currentColor;
  }

  /* Al abrir un apartado, sus filas aparecen una tras otra. */
  .career__item[open] .row {
    animation: row-in 500ms var(--ease-out) both;
    animation-delay: calc(var(--row, 0) * 35ms);
  }

  @keyframes row-in {
    from {
      opacity: 0;
      transform: translateY(0.4rem);
    }
  }

  .row > span:last-child {
    display: grid;
    gap: 0.1rem;
  }

  .row strong {
    font-weight: 600;
  }

  .row__note {
    color: var(--color-muted);
  }

  /* Móvil y tableta: frase, luego la C (con el vídeo) y el retrato lado a lado,
     y debajo los apartados. Al pulsar «Trayectoria» cabe casi todo en pantalla. */
  @media (max-width: 900px) {
    .career {
      min-height: 0;
      padding-top: 5.5rem;
      padding-bottom: var(--space-4);
      row-gap: var(--space-4);
    }

    .career__statement {
      grid-row: 1;
      font-size: clamp(1.7rem, 7vw, 2.8rem);
    }

    .career__letter {
      position: relative;
      top: auto;
      left: auto;
      translate: none;
      grid-row: 2;
      grid-column: 1 / span 7;
      align-self: center;
      justify-self: start;
      font-size: min(78vw, 36rem);
    }

    .career__index {
      grid-row: 3;
      grid-column: 1 / -1;
    }

    .career__portrait {
      grid-row: 2;
      grid-column: 6 / -1;
      justify-self: end;
      width: 100%;
      max-width: 22rem;
    }

    .career__item summary {
      grid-template-columns: 2.75rem 1fr auto;
    }

    .row {
      grid-template-columns: 5.25rem minmax(0, 1fr);
    }

    .career__statement {
      text-indent: 0;
    }
  }
</style>
