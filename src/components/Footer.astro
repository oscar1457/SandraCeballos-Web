---
import type { Site } from "@/data/site";

type Props = {
  site: Site;
};

const { site } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer" data-header="dark">
  <a href={`mailto:${site.email}`}>{site.email}</a>
  <span class="num">{site.name} / {year}</span>
  <nav aria-label="Enlaces secundarios" data-aria-label-en="Secondary links">
    <a href="/privacidad">
      <span data-lang="es">{site.footer.privacy}</span>
      <span data-lang="en">{site.footer.privacyEn}</span>
    </a>
    <a href="/aviso-legal">
      <span data-lang="es">{site.footer.legal}</span>
      <span data-lang="en">{site.footer.legalEn}</span>
    </a>
  </nav>
</footer>

<style>
  .site-footer {
    display: grid;
    grid-template-columns: 1fr 1fr auto;
    gap: var(--space-2);
    padding: var(--gutter) var(--gutter) var(--space-4);
    background: var(--stone);
    color: var(--black);
    font-size: var(--text-small);
    font-weight: 500;
  }

  .site-footer nav {
    display: flex;
    gap: var(--space-2);
  }

  .site-footer a {
    display: inline-block;
    padding-block: 0.3rem;
  }

  @media (max-width: 620px) {
    .site-footer {
      grid-template-columns: 1fr;
    }
  }
</style>
