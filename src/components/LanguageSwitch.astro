---
type Props = {
  label?: string;
};

const { label = "Idioma" } = Astro.props;
---

<div class="language-switch" role="group" aria-label={label} data-aria-label-en="Language">
  <button type="button" data-language-switch="es" aria-current="true" lang="es">ES</button>
  <button type="button" data-language-switch="en" lang="en">EN</button>
</div>

<style>
  .language-switch {
    display: flex;
    gap: 0.15rem;
  }

  .language-switch button {
    min-width: 2.5rem;
    min-height: 2.5rem;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-muted);
    font-size: var(--text-small);
    cursor: pointer;
  }

  .language-switch button:hover {
    color: var(--color-ink);
  }

  .language-switch button[aria-current="true"] {
    color: var(--color-ink);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }
</style>

