---
// Noticias de portada: entran desde la derecha al segundo de llegar y cada una
// lleva a su historia de «In the studio». Si hay varias, se turnan solas
// (con tiempo para leer) y se pueden pasar a mano.
import { getImage } from "astro:assets";
import { stories } from "@/data/studio";

const items = await Promise.all(
  stories
    .filter((story) => story.news)
    .map(async (story) => ({
      slug: story.slug,
      news: story.news!,
      image: await getImage({ src: story.news!.image, width: 640, format: "webp" })
    }))
);
---

<aside class="news news--intro" data-news aria-label="Noticias" data-aria-label-en="News" style={`--news-count:${items.length}`}>
  <div class="news__mast">
    <span class="news__label">News</span>
    {
      items.length > 1 && (
        <span class="news__dots">
          {items.map((_, index) => (
            <button
              type="button"
              class="news__dot"
              data-news-dot={index}
              aria-label={`Noticia ${index + 1}`}
              aria-current={index === 0 ? "true" : undefined}
            >
              <i />
            </button>
          ))}
        </span>
      )
    }
    <button type="button" class="news__close" data-news-close aria-label="Cerrar noticia" data-aria-label-en="Close news">×</button>
  </div>

  <div class="news__items">
    {
      items.map((item, index) => (
        <a
          class="news__link"
          href={`#taller/${item.slug}`}
          data-news-link
          data-news-item={index}
          aria-hidden={index === 0 ? undefined : "true"}
          tabindex={index === 0 ? undefined : -1}
        >
          <img class="news__image" src={item.image.src} width="640" height="480" alt="" decoding="async" />
          <p class="news__kicker">{item.news.kicker}</p>
          <p class="news__meta num">{item.news.meta}</p>
          <h2 class="news__title">
            <span data-lang="es">{item.news.headline}</span>
            <span data-lang="en">{item.news.headlineEn}</span>
          </h2>
          <span class="news__cta">
            <span data-lang="es">Leer la historia</span><span data-lang="en">Read the story</span> →
          </span>
        </a>
      ))
    }
  </div>
</aside>

<script>
  // La entrada la hace el CSS (animación con 1 s de retraso desde que se pinta
  // la página), así no espera a que cargue el JavaScript. Aquí solo se gestiona
  // lo demás: retirarse al bajar, volver al subir a la portada y cerrar.
  import { gsap } from "gsap";

  const card = document.querySelector<HTMLElement>("[data-news]");
  const intro = document.getElementById("inicio");
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  // De momento solo en escritorio: en el móvil el CSS la oculta (pendiente de decidir).
  const narrow = window.matchMedia("(max-width: 760px)").matches;

  if (card && intro && !narrow) {
    const SHOWN = { xPercent: 0, rotate: -1.5 };

    // ---- Varias noticias: se turnan cada 5 s, siempre (no se para con el ratón) ----
    const READ_TIME = 5;
    const links = Array.from(card.querySelectorAll<HTMLElement>("[data-news-item]"));
    const dots = Array.from(card.querySelectorAll<HTMLElement>("[data-news-dot]"));
    let currentItem = 0;
    let progress: gsap.core.Tween | null = null;

    const showItem = (index: number, animate = true) => {
      const next = (index + links.length) % links.length;
      const from = links[currentItem];
      const to = links[next];
      if (!to) return;
      if (from && from !== to) {
        from.setAttribute("aria-hidden", "true");
        from.tabIndex = -1;
        if (animate && !reduced) gsap.to(from, { autoAlpha: 0, x: -16, duration: 0.3, overwrite: true });
        else gsap.set(from, { autoAlpha: 0 });
      }
      to.removeAttribute("aria-hidden");
      to.removeAttribute("tabindex");
      if (animate && !reduced && from !== to) {
        gsap.fromTo(to, { autoAlpha: 0, x: 16 }, { autoAlpha: 1, x: 0, duration: 0.45, delay: 0.15, overwrite: true });
      } else {
        gsap.set(to, { autoAlpha: 1, x: 0 });
      }
      currentItem = next;
      dots.forEach((dot, dotIndex) => {
        dot.toggleAttribute("aria-current", dotIndex === next);
        const fill = dot.firstElementChild as HTMLElement | null;
        if (fill) gsap.set(fill, { scaleX: dotIndex < next ? 1 : 0 });
      });
      startTimer();
    };

    const startTimer = () => {
      progress?.kill();
      progress = null;
      if (links.length < 2) return;
      const fill = dots[currentItem]?.firstElementChild as HTMLElement | null;
      if (!fill) return;
      progress = gsap.fromTo(
        fill,
        { scaleX: 0 },
        { scaleX: 1, duration: READ_TIME, ease: "none", onComplete: () => showItem(currentItem + 1) }
      );
    };

    links.forEach((link, index) => {
      if (index > 0) gsap.set(link, { autoAlpha: 0 });
    });
    dots.forEach((dot, index) => dot.addEventListener("click", () => showItem(index)));
    let onIntro = true;
    let closed = false; // cerrada o pulsada; se olvida al salir de la portada
    let timer = 0;

    // Cuando termina la entrada por CSS, GSAP toma el control de la posición.
    const takeOver = () => {
      if (!card.classList.contains("news--intro")) return;
      card.classList.remove("news--intro");
      gsap.set(card, SHOWN);
    };
    card.addEventListener("animationend", (event) => {
      if (event.target !== card) return;
      takeOver();
      showItem(0, false);
    });
    // Sin animación de entrada (movimiento reducido) el turno empieza ya.
    if (reduced) window.setTimeout(() => showItem(0, false), 1000);

    const slideIn = () => {
      if (closed || !onIntro || !card.hidden) return;
      card.hidden = false;
      showItem(0, false);
      if (reduced) {
        gsap.set(card, SHOWN);
        return;
      }
      gsap.fromTo(card, { xPercent: 115, rotate: 4 }, { ...SHOWN, duration: 0.8, ease: "power3.out", overwrite: true });
    };

    const slideOut = (instant = false) => {
      if (card.hidden) return;
      const midIntro = card.classList.contains("news--intro");
      takeOver();
      gsap.to(card, {
        xPercent: 115,
        duration: reduced || instant || midIntro ? 0 : 0.45,
        ease: "power3.in",
        overwrite: true,
        onComplete: () => {
          card.hidden = true;
          progress?.kill();
        }
      });
    };

    new IntersectionObserver(
      (entries) => {
        const nowOnIntro = entries.some((entry) => entry.intersectionRatio >= 0.8);
        if (nowOnIntro === onIntro) return;
        onIntro = nowOnIntro;
        window.clearTimeout(timer);
        if (onIntro) {
          timer = window.setTimeout(slideIn, 500);
        } else {
          closed = false;
          slideOut();
        }
      },
      { threshold: 0.8 }
    ).observe(intro);

    // Con el teclado: si el foco va a otra parte de la página, se quita al momento.
    document.addEventListener("focusin", (event) => {
      const target = event.target as Node;
      if (card.hidden || card.contains(target) || intro.contains(target)) return;
      slideOut(true);
    });

    const dismiss = () => {
      closed = true;
      window.clearTimeout(timer);
      slideOut();
    };
    card.querySelector("[data-news-close]")?.addEventListener("click", dismiss);
    card.querySelector("[data-news-link]")?.addEventListener("click", dismiss);
  }
</script>

<style>
  /* Recorte de periódico pegado en el borde derecho de la portada. */
  .news {
    position: fixed;
    right: var(--gutter);
    bottom: calc(var(--gutter) + 4rem);
    z-index: 90;
    width: min(21rem, calc(100vw - 2 * var(--gutter)));
    padding: 0.9rem;
    background: #fbfaf7;
    color: var(--black);
    box-shadow: 0 1.2rem 2.5rem rgb(0 0 0 / 0.28);
    transform-origin: 50% 50%;
  }

  .news[hidden] {
    display: none;
  }

  /* Entrada desde la derecha, 1 s después de pintar la página. */
  .news--intro {
    animation: news-in 0.8s cubic-bezier(0.22, 1, 0.36, 1) 1s both;
  }

  @keyframes news-in {
    from {
      transform: translateX(115%) rotate(4deg);
    }

    to {
      transform: rotate(-1.5deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .news--intro {
      animation: none;
      transform: rotate(-1.5deg);
    }
  }

  .news__mast {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    padding-bottom: 0.45rem;
    border-bottom: 3px double var(--black);
  }

  .news__label {
    font-family: var(--font-serif);
    font-size: 1.9rem;
    line-height: 1;
    text-transform: uppercase;
  }

  /* Una rayita por noticia, como las historias: se llena mientras se lee. */
  .news__dots {
    display: flex;
    flex: 1;
    gap: 0.3rem;
    align-self: center;
  }

  .news__dot {
    flex: 1;
    height: 1.5rem;
    margin-block: -0.25rem;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  /* Fondo gris y relleno rojo que crece de izquierda a derecha. */
  .news__dot {
    position: relative;
  }

  .news__dot::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 3px;
    margin-top: -1.5px;
    background: rgb(0 0 0 / 0.15);
  }

  .news__dot i {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    z-index: 1;
    height: 3px;
    margin-top: -1.5px;
    background: var(--red);
    transform: scaleX(0);
    transform-origin: left;
  }

  .news__close {
    width: 1.6rem;
    height: 1.6rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--black);
    font-size: 1.4rem;
    line-height: 1;
    cursor: pointer;
  }

  /* Todas las noticias ocupan el mismo hueco; se ve una cada vez. */
  .news__items {
    display: grid;
    margin-top: 0.7rem;
  }

  .news__link {
    display: block;
    grid-area: 1 / 1;
    color: inherit;
    text-decoration: none;
  }

  /* Lo que se tiene que ver de un vistazo: "DOCUMENTA FIFTEEN". */
  .news__kicker {
    margin: 0.75rem 0 0;
    color: var(--red);
    font-family: var(--font-serif);
    font-size: 1.85rem;
    line-height: 0.95;
    text-transform: uppercase;
  }

  .news__meta {
    margin: 0.3rem 0 0;
    font-size: var(--text-label);
    font-weight: 600;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .news__image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: 50% 20%;
  }

  .news__title {
    margin: 0.55rem 0 0;
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .news__dek {
    margin: 0.45rem 0 0;
    font-size: 0.85rem;
    font-weight: 500;
    line-height: 1.3;
  }

  .news__cta {
    display: inline-block;
    margin-top: 0.7rem;
    color: var(--red);
    font-size: var(--text-small);
    font-weight: 600;
  }

  .news__link:hover .news__cta,
  .news__link:focus-visible .news__cta {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  /* En móvil: más compacto, la foto al lado del texto. De momento oculta. */
  @media (max-width: 760px) {
    .news {
      display: none;
      bottom: var(--gutter);
      padding: 0.7rem;
    }

    .news__label {
      font-size: 1.5rem;
    }

    .news__link {
      display: grid;
      grid-template-columns: 6.5rem minmax(0, 1fr);
      grid-template-rows: auto auto auto;
      column-gap: 0.7rem;
    }

    .news__image {
      grid-row: 1 / span 3;
      aspect-ratio: 3 / 4;
    }

    .news__title {
      margin-top: 0;
      font-size: 1.15rem;
    }

    .news__dek {
      font-size: 0.78rem;
    }
  }
</style>
