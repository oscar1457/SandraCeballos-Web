---
import { Image } from "astro:assets";
import { publicationImages, publications } from "@/data/publications";

const shots = [publicationImages.covers, publicationImages.spread];
---

<section class="pubs" id="publicaciones" data-header="dark" data-pubs aria-labelledby="pubs-title">
  <div class="pubs__sticky">
    <div class="pubs__track" data-pubs-track>
      <div class="pubs__panel pubs__panel--text">
        <h2 class="pubs__title" id="pubs-title">
          <span data-lang="es">Publicaciones</span>
          <span data-lang="en">Publications</span>
        </h2>
        <p class="pubs__hint" aria-hidden="true">
          <span data-lang="es">Desliza para ver los catálogos →</span>
          <span data-lang="en">Swipe to see the catalogues →</span>
        </p>
        <ul class="pubs__list">
          {
            publications.map((publication) => (
              <li>
                <span class="pubs__name">{publication.title}</span>
                <span class="pubs__meta">
                  <span data-lang="es">{publication.kind}</span>
                  <span data-lang="en">{publication.kindEn}</span>
                  {publication.year && <span class="num"> · {publication.year}</span>}
                </span>
                <span class="pubs__meta">
                  <span data-lang="es">{publication.details}</span>
                  <span data-lang="en">{publication.detailsEn}</span>
                </span>
              </li>
            ))
          }
        </ul>
      </div>

      {
        shots.map((shot) => (
          <figure class="pubs__panel pubs__shot">
            <Image
              src={shot.image}
              alt={shot.alt}
              widths={[900, 1300, 1536]}
              sizes="(max-width: 760px) 90vw, 120svh"
              loading="lazy"
            />
            <figcaption>
              <span data-lang="es">{shot.caption}</span>
              <span data-lang="en">{shot.captionEn}</span>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<script>
  // Sección horizontal: en escritorio la página se queda fija y las fotos
  // se desplazan de lado al hacer scroll. En móvil se desliza con el dedo.
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const section = document.querySelector<HTMLElement>("[data-pubs]");
  const track = document.querySelector<HTMLElement>("[data-pubs-track]");
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (section && track && !reduced) {
    const mm = gsap.matchMedia();
    mm.add("(min-width: 761px)", () => {
      const distance = () => Math.max(0, track.scrollWidth - window.innerWidth);
      const setHeight = () => {
        section.style.height = `${distance() + window.innerHeight}px`;
      };
      setHeight();
      const tween = gsap.to(track, {
        x: () => -distance(),
        ease: "none",
        scrollTrigger: {
          trigger: section,
          start: "top top",
          end: "bottom bottom",
          scrub: true,
          invalidateOnRefresh: true,
          onRefreshInit: setHeight
        }
      });
      return () => {
        tween.scrollTrigger?.kill();
        tween.kill();
        section.style.height = "";
        gsap.set(track, { x: 0 });
      };
    });
  }
</script>

<style>
  .pubs {
    position: relative;
    background: var(--white);
    color: var(--black);
  }

  .pubs__sticky {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
  }

  .pubs__track {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    width: max-content;
    height: 100%;
    padding: 6rem var(--gutter) var(--gutter);
    will-change: transform;
  }

  .pubs__panel {
    flex: none;
  }

  .pubs__panel--text {
    display: grid;
    align-content: center;
    gap: var(--space-3);
    width: min(50rem, 85vw);
  }

  .pubs__kicker {
    margin: 0;
    font-size: var(--text-small);
    font-weight: 600;
  }

  .pubs__title {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(2.4rem, 5.4vw, 5.6rem);
    font-weight: 400;
    line-height: 0.9;
    text-transform: uppercase;
  }

  .pubs__hint {
    display: none;
    margin: 0;
    font-size: var(--text-small);
    font-weight: 500;
  }

  .pubs__list {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pubs__list li {
    display: grid;
    gap: 0.2rem;
    padding-top: 0.6rem;
    border-top: 1px solid var(--black);
  }

  .pubs__name {
    font-family: var(--font-serif);
    font-size: clamp(1.6rem, 2.4vw, 2.4rem);
    line-height: 1;
    text-transform: uppercase;
  }

  .pubs__meta {
    font-size: var(--text-small);
    font-weight: 500;
  }

  .pubs__shot {
    margin: 0;
  }

  .pubs__shot img {
    width: auto;
    height: min(74svh, 60rem);
    max-width: none;
  }

  .pubs__shot figcaption {
    margin-top: 0.6rem;
    font-size: var(--text-small);
    font-weight: 500;
  }

  @media (max-width: 760px) {
    .pubs__sticky {
      position: static;
      height: auto;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
    }

    .pubs__track {
      height: auto;
      padding: 5rem var(--gutter) var(--space-4);
      gap: var(--space-3);
    }

    .pubs__hint {
      display: block;
    }

    .pubs__panel {
      scroll-snap-align: start;
    }

    .pubs__shot img {
      width: 88vw;
      height: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pubs__sticky {
      position: static;
      height: auto;
      overflow-x: auto;
    }
  }
</style>
