---
import { Image } from "astro:assets";
import { publicationImages, publications } from "@/data/publications";

const shots = [
  publicationImages.covers,
  publicationImages.spread,
  publicationImages.bestiaEspana,
  publicationImages.bellaCastillo,
  publicationImages.bestiaGaleriaHabana,
  publicationImages.bellaNaranja
];
---

<section class="pubs" id="publicaciones" data-header="dark" data-pubs aria-labelledby="pubs-title">
  <div class="pubs__sticky">
    <div class="pubs__track" data-pubs-track>
      <div class="pubs__panel pubs__panel--text">
        <h2 class="pubs__title" id="pubs-title">
          <span data-lang="es">Publicaciones</span>
          <span data-lang="en">Publications</span>
        </h2>
        <ul class="pubs__list">
          {
            publications.map((publication) => (
              <li>
                <span class="pubs__name">{publication.title}</span>
                <span class="pubs__meta">
                  <span data-lang="es">{publication.kind}</span>
                  <span data-lang="en">{publication.kindEn}</span>
                  {publication.year && <span class="num"> · {publication.year}</span>}
                </span>
                <span class="pubs__meta">
                  <span data-lang="es">{publication.details}</span>
                  <span data-lang="en">{publication.detailsEn}</span>
                </span>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- En el teléfono las portadas van en una cuadrícula de dos columnas. -->
      <div class="pubs__shots">
      {
        shots.map((shot) => (
          <figure class="pubs__panel pubs__shot">
            <Image
              src={shot.image}
              alt={shot.alt}
              widths={[900, 1300, 1536]}
              sizes="(max-width: 760px) 46vw, 120svh"
              loading="lazy"
            />
            <figcaption>
              <span data-lang="es">{shot.caption}</span>
              <span data-lang="en">{shot.captionEn}</span>
            </figcaption>
          </figure>
        ))
      }
      </div>
    </div>
  </div>
</section>

<script>
  // Sección horizontal: en escritorio la página se queda fija y las fotos
  // se desplazan de lado al hacer scroll. En móvil se desliza con el dedo.
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const section = document.querySelector<HTMLElement>("[data-pubs]");
  const track = document.querySelector<HTMLElement>("[data-pubs-track]");
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // Con movimiento reducido, en pantallas anchas los catálogos se desplazan de
  // lado dentro de la sección: se puede llegar y moverlos con el teclado.
  const sticky = section?.querySelector<HTMLElement>(".pubs__sticky");
  if (sticky && reduced) {
    const wide = window.matchMedia("(min-width: 761px)");
    const sync = () => {
      if (wide.matches) {
        sticky.tabIndex = 0;
        sticky.setAttribute("role", "region");
        sticky.setAttribute("aria-label", document.documentElement.lang === "en" ? "Catalogues" : "Catálogos");
      } else {
        sticky.removeAttribute("tabindex");
        sticky.removeAttribute("role");
        sticky.removeAttribute("aria-label");
      }
    };
    sync();
    wide.addEventListener("change", sync);
  }

  if (section && track && !reduced) {
    const mm = gsap.matchMedia();
    mm.add("(min-width: 761px)", () => {
      const distance = () => Math.max(0, track.scrollWidth - window.innerWidth);
      const setHeight = () => {
        section.style.height = `${distance() + window.innerHeight}px`;
      };
      setHeight();
      const tween = gsap.to(track, {
        x: () => -distance(),
        ease: "none",
        scrollTrigger: {
          trigger: section,
          start: "top top",
          end: "bottom bottom",
          scrub: true,
          invalidateOnRefresh: true,
          onRefreshInit: setHeight
        }
      });
      return () => {
        tween.scrollTrigger?.kill();
        tween.kill();
        section.style.height = "";
        gsap.set(track, { x: 0 });
      };
    });
  }
</script>

<style>
  .pubs {
    position: relative;
    background: var(--white);
    color: var(--black);
  }

  .pubs__sticky {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
  }

  /* Lista y fotos empiezan arriba (antes iban centradas en la pantalla y
     dejaban un hueco grande al llegar desde Trayectoria). */
  .pubs__track {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    width: max-content;
    height: 100%;
    padding: 6rem var(--gutter) var(--gutter);
    will-change: transform;
  }

  .pubs__panel {
    flex: none;
  }

  .pubs__panel--text {
    display: grid;
    align-content: start;
    gap: var(--space-3);
    width: min(50rem, 85vw);
  }

  .pubs__kicker {
    margin: 0;
    font-size: var(--text-small);
    font-weight: 600;
  }

  .pubs__title {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(2.4rem, 5.4vw, 5.6rem);
    font-weight: 400;
    line-height: 0.9;
    text-transform: uppercase;
  }

  /* Con varios catálogos, la lista va en dos columnas para caber en pantalla. */
  .pubs__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-2) var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pubs__list li {
    display: grid;
    gap: 0.2rem;
    padding-top: 0.6rem;
    border-top: 1px solid var(--black);
  }

  .pubs__name {
    font-family: var(--font-serif);
    font-size: clamp(1.6rem, 2.4vw, 2.4rem);
    line-height: 1;
    text-transform: uppercase;
  }

  .pubs__meta {
    font-size: var(--text-small);
    font-weight: 500;
  }

  /* En escritorio el envoltorio no cuenta: las fotos siguen en la misma fila. */
  .pubs__shots {
    display: contents;
  }

  .pubs__shot {
    margin: 0;
  }

  .pubs__shot img {
    width: auto;
    height: min(74svh, 60rem);
    max-width: none;
  }

  .pubs__shot figcaption {
    margin-top: 0.6rem;
    font-size: var(--text-small);
    font-weight: 500;
  }

  /* Teléfono: título y debajo las portadas en dos columnas, cada una con su
     título. Sin lista de textos y sin desplazamiento lateral. */
  @media (max-width: 760px) {
    .pubs__sticky {
      position: static;
      height: auto;
      overflow: visible;
    }

    .pubs__track {
      display: block;
      width: auto;
      height: auto;
      padding: 5rem var(--gutter) var(--space-4);
    }

    .pubs__panel--text {
      width: auto;
      margin-bottom: var(--space-3);
    }

    .pubs__title {
      font-size: clamp(2.2rem, 11vw, 3rem);
    }

    .pubs__list {
      display: none;
    }

    .pubs__shots {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-3) var(--space-2);
      align-items: start;
    }

    .pubs__shot img {
      display: block;
      width: 100%;
      height: auto;
      max-width: 100%;
    }

    .pubs__shot figcaption {
      margin-top: 0.4rem;
      font-size: 0.8rem;
      line-height: 1.25;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pubs__sticky {
      position: static;
      height: auto;
      overflow-x: auto;
    }
  }
</style>
