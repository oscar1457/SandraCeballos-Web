---
import LanguageSwitch from "@/components/LanguageSwitch.astro";
import type { Site } from "@/data/site";

type Props = {
  site: Site;
  workCount: number;
};

const { site, workCount } = Astro.props;
---

<!--
  La cabecera cambia de color según la sección que tiene debajo:
  cada sección declara data-header="light" (texto blanco) o "dark" (texto negro).
-->
<header class="site-header" data-site-header data-tone="light">
  <a class="site-header__logo" href="#inicio">
    <span class="site-header__mark" aria-hidden="true">SC</span>
    <span class="site-header__name">
      {site.name}
      <br />
      <span data-lang="es">{site.role}</span>
      <span data-lang="en">{site.roleEn}</span>
    </span>
  </a>
  <nav class="site-header__nav" aria-label="Navegación principal" data-aria-label-en="Main navigation">
    <a href="#obra">
      <span data-lang="es">Obra</span><span data-lang="en">Work</span><sup class="num">{workCount}</sup>
    </a>
    <a href="#trayectoria">
      <span data-lang="es">Trayectoria</span><span data-lang="en">Career</span>
    </a>
    <a href="#publicaciones">
      <span data-lang="es">Publicaciones</span><span data-lang="en">Publications</span>
    </a>
    <a href="#contacto">
      <span data-lang="es">Contacto</span><span data-lang="en">Contact</span>
    </a>
    <LanguageSwitch />
  </nav>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: var(--z-header);
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-2);
    padding: var(--gutter);
    color: var(--white);
    font-size: var(--text-small);
    font-weight: 500;
    line-height: 1.1;
    transition: color 300ms var(--ease);
    pointer-events: none;
  }

  .site-header[data-tone="dark"] {
    color: var(--black);
  }

  .site-header a,
  .site-header :global(button) {
    pointer-events: auto;
  }

  .site-header__logo {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
  }

  .site-header__mark {
    font-family: var(--font-serif);
    font-size: 2.1rem;
    line-height: 0.8;
    letter-spacing: -0.04em;
  }

  .site-header__nav {
    display: flex;
    align-items: center;
    gap: clamp(0.8rem, 1.6vw, 1.6rem);
  }

  .site-header__nav a {
    text-decoration: none;
  }

  .site-header__nav a:hover {
    text-decoration: underline;
  }

  .site-header__nav sup {
    margin-left: 0.1em;
    font-size: 0.6em;
  }

  @media (max-width: 760px) {
    .site-header {
      flex-wrap: wrap;
    }

    .site-header__nav {
      width: 100%;
      flex-wrap: wrap;
      gap: 0.4rem 0.9rem;
    }
  }
</style>
