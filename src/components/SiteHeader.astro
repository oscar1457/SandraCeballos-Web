---
import LanguageSwitch from "@/components/LanguageSwitch.astro";
import type { Site } from "@/data/site";

type Props = {
  site: Site;
  workCount: number;
};

const { site, workCount } = Astro.props;
---

<!--
  La cabecera cambia de color según la sección que tiene debajo:
  cada sección declara data-header="light" (texto blanco) o "dark" (texto negro).
-->
<header class="site-header" data-site-header data-tone="light">
  <a class="site-header__logo" href="#inicio">
    <span class="site-header__mark" aria-hidden="true">SC</span>
    <span class="site-header__name">
      {site.name}
      <br />
      <span data-lang="es">{site.role}</span>
      <span data-lang="en">{site.roleEn}</span>
    </span>
  </a>
  <button
    type="button"
    class="site-header__menu"
    aria-expanded="false"
    aria-controls="site-nav"
    data-menu-button
  >
    <span data-lang="es">Menú</span><span data-lang="en">Menu</span>
  </button>
  <nav
    class="site-header__nav"
    id="site-nav"
    aria-label="Navegación principal"
    data-aria-label-en="Main navigation"
    data-menu
  >
    <a href="#obra">
      <span data-lang="es">Obra</span><span data-lang="en">Work</span><sup class="num">{workCount}</sup>
    </a>
    <a href="#trayectoria">
      <span data-lang="es">Trayectoria</span><span data-lang="en">Career</span>
    </a>
    <a href="/aglutinador/">Aglutinador</a>
    <a href="#publicaciones">
      <span data-lang="es">Publicaciones</span><span data-lang="en">Publications</span>
    </a>
    <a href="#contacto">
      <span data-lang="es">Contacto</span><span data-lang="en">Contact</span>
    </a>
    <LanguageSwitch />
  </nav>
</header>

<script>
  // Menú de móvil: abre y cierra la lista de secciones a pantalla completa.
  const header = document.querySelector<HTMLElement>("[data-site-header]");
  const button = document.querySelector<HTMLButtonElement>("[data-menu-button]");
  if (header && button) {
    const setOpen = (open: boolean) => {
      header.classList.toggle("is-open", open);
      button.setAttribute("aria-expanded", String(open));
      document.documentElement.classList.toggle("menu-open", open);
    };
    button.addEventListener("click", () => setOpen(!header.classList.contains("is-open")));
    header.querySelectorAll("[data-menu] a").forEach((link) =>
      link.addEventListener("click", () => setOpen(false))
    );
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && header.classList.contains("is-open")) {
        setOpen(false);
        button.focus();
      }
    });
  }
</script>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: var(--z-header);
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-2);
    padding: var(--gutter);
    background: var(--header-bg, transparent);
    color: var(--white);
    font-size: var(--text-small);
    font-weight: 500;
    line-height: 1.1;
    /* Sin transición: el color cambia en el mismo fotograma en que la
       sección de debajo cruza el centro de la cabecera (ver smooth.ts). Un
       fundido iba por detrás del scroll y se veía como un parpadeo. */
  }

  /* Sobre rojo o negro, el idioma no elegido casi no se atenúa: así se lee
     bien (contraste suficiente); el subrayado marca el idioma activo. */
  .site-header[data-tone="light"] :global(.language-switch button) {
    opacity: 0.95;
  }

  .site-header[data-tone="dark"] {
    color: var(--black);
  }

  .site-header__logo {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
  }

  .site-header__mark {
    font-family: var(--font-serif);
    font-size: 2.1rem;
    line-height: 0.8;
    letter-spacing: -0.04em;
  }

  .site-header__nav {
    display: flex;
    align-items: center;
    gap: clamp(0.8rem, 1.6vw, 1.6rem);
  }

  .site-header__nav a {
    text-decoration: none;
  }

  .site-header__nav a:hover {
    text-decoration: underline;
  }

  .site-header__nav sup {
    margin-left: 0.1em;
    font-size: 0.6em;
  }

  .site-header__menu {
    display: none;
    position: relative;
    z-index: 2;
    padding: 0.4rem 0;
    border: 0;
    background: none;
    font-size: inherit;
    font-weight: 500;
  }

  @media (max-width: 760px) {
    .site-header {
      align-items: center;
    }

    .site-header__logo {
      position: relative;
      z-index: 2;
    }

    .site-header__menu {
      display: block;
    }

    /* El menú ocupa toda la pantalla, en negro, con enlaces grandes. */
    .site-header__nav {
      position: fixed;
      inset: 0;
      z-index: 1;
      flex-direction: column;
      align-items: flex-start;
      justify-content: flex-end;
      gap: 0.4rem;
      padding: 6rem var(--gutter) 3rem;
      background: var(--black);
      color: var(--white);
      font-family: var(--font-serif);
      font-size: clamp(2.6rem, 13vw, 4rem);
      line-height: 1;
      text-transform: uppercase;
      clip-path: inset(0 0 100% 0);
      visibility: hidden;
      transition:
        clip-path 600ms var(--ease),
        visibility 0s linear 600ms;
    }

    .site-header.is-open {
      color: var(--white);
    }

    .site-header.is-open .site-header__nav {
      clip-path: inset(0 0 0 0);
      visibility: visible;
      transition: clip-path 600ms var(--ease);
      pointer-events: auto;
    }

    .site-header__nav :global(.language-switch) {
      margin-top: var(--space-3);
      font-family: var(--font-sans);
      font-size: 1rem;
      text-transform: none;
    }
  }
</style>
