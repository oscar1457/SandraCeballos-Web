---
// Sección "En el taller", entre la obra y la trayectoria. El vídeo de Sandra
// trabajando no se muestra como vídeo sino como fondo con trama de imprenta:
// cada fotograma se convierte en puntos (WebGL) que se dibujan nítidos a
// cualquier tamaño, así la baja resolución del vídeo no se nota.
import { getImage } from "astro:assets";
import posterImage from "@/assets/sandra-taller-poster.jpg";

const poster = await getImage({ src: posterImage, width: 576, format: "webp" });
---

<section class="studio" id="taller" data-header="light" aria-labelledby="studio-title" data-studio data-poster={poster.src}>
  <div class="studio__media" aria-hidden="true">
    <!-- Respaldo sin WebGL: el póster en duotono. -->
    <img class="studio__fallback" src={poster.src} alt="" width="576" height="972" loading="lazy" decoding="async" />
    <canvas class="studio__canvas" data-studio-canvas></canvas>
    <video
      class="studio__source"
      data-studio-video
      width="360"
      height="608"
      muted
      loop
      playsinline
      preload="none"
      tabindex="-1"
    ></video>
  </div>

  <div class="studio__content">
    <h2 class="studio__title" id="studio-title">
      <span data-lang="es">En el taller</span>
      <span data-lang="en">In the studio</span>
    </h2>
    <p class="studio__lead">
      <span data-lang="es">Dibujo, color y escritura a mano sobre papel, trazo a trazo.</span>
      <span data-lang="en">Drawing, colour and handwriting on paper, stroke by stroke.</span>
    </p>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { attachSources, createHalftone } from "@/scripts/halftone";

  gsap.registerPlugin(ScrollTrigger);

  const section = document.querySelector<HTMLElement>("[data-studio]");
  const canvas = section?.querySelector<HTMLCanvasElement>("[data-studio-canvas]");
  const video = section?.querySelector<HTMLVideoElement>("[data-studio-video]");
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // Fondo rojo y tinta casi negra; celdas de 6 px en móvil, algo mayores en pantallas anchas.
  const halftone =
    canvas &&
    createHalftone(canvas, {
      paper: [210, 43, 24],
      ink: [26, 8, 6],
      cell: (width) => Math.max(6, width / 190)
    });

  if (section && canvas && video && halftone) {
    section.classList.add("is-halftone");
    let visible = false;
    let frame = 0;
    let lastTime = -1;
    let videoFrame = false;

    const loop = () => {
      frame = 0;
      if (!visible) return;
      if (video.readyState >= 2 && video.currentTime !== lastTime) {
        lastTime = video.currentTime;
        videoFrame = true;
        halftone.upload(video, video.videoWidth, video.videoHeight);
      }
      halftone.draw();
      frame = requestAnimationFrame(loop);
    };
    const start = () => {
      if (!frame) frame = requestAnimationFrame(loop);
    };

    // Primera imagen: el póster, para que la trama aparezca antes que el vídeo.
    const posterSrc = section.dataset.poster;
    if (posterSrc) {
      const image = new Image();
      image.decoding = "async";
      image.onload = () => {
        if (!videoFrame) halftone.upload(image, image.naturalWidth, image.naturalHeight);
        halftone.draw();
      };
      image.src = posterSrc;
    }

    // El vídeo (1 MB, sin sonido) solo se descarga cuando la sección se acerca.
    const load = () => {
      if (!reduced) attachSources(video, "/video/sandra-taller");
    };

    new IntersectionObserver(
      (entries) => {
        if (entries.some((entry) => entry.isIntersecting)) load();
      },
      { rootMargin: "100% 0px" }
    ).observe(section);

    new IntersectionObserver((entries) => {
      visible = entries.some((entry) => entry.isIntersecting);
      if (visible) {
        halftone.resize();
        if (!reduced) {
          load();
          video.play().catch(() => {});
          start();
        } else {
          halftone.draw();
        }
      } else {
        video.pause();
      }
    }).observe(section);

    new ResizeObserver(() => {
      halftone.resize();
      halftone.draw();
    }).observe(canvas);

    // Al hacer scroll, la "cámara" recorre el vídeo vertical de arriba abajo.
    if (!reduced) {
      ScrollTrigger.create({
        trigger: section,
        start: "top bottom",
        end: "bottom top",
        onUpdate: (self) => halftone.setPan(self.progress * 1.6 - 0.8)
      });
    }
  }
</script>

<style>
  .studio {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr auto;
    min-height: 100svh;
    padding: calc(4rem + var(--gutter)) var(--gutter) var(--gutter);
    overflow: hidden;
    isolation: isolate;
    background: var(--red);
    color: var(--white);
  }

  .studio__media {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: var(--red);
  }

  .studio__canvas,
  .studio__fallback {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* Sin WebGL: póster en blanco y negro multiplicado sobre el rojo. */
  .studio__fallback {
    object-fit: cover;
    filter: grayscale(1) contrast(1.4);
    mix-blend-mode: multiply;
  }

  .studio.is-halftone .studio__fallback {
    display: none;
  }

  .studio:not(.is-halftone) .studio__canvas {
    display: none;
  }

  /* El vídeo solo alimenta la trama; no se ve. */
  .studio__source {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .studio__content {
    display: contents;
  }

  .studio__title {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(3.2rem, 13vw, 15rem);
    font-weight: 400;
    line-height: 0.82;
    text-transform: uppercase;
  }

  .studio__lead {
    grid-row: 3;
    max-width: 22ch;
    margin: 0;
    font-size: clamp(1.15rem, 2vw, 2.2rem);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  @media (max-width: 760px) {
    .studio {
      min-height: 90svh;
    }

    .studio__title {
      font-size: clamp(3rem, 17vw, 6rem);
    }
  }
</style>
