---
import { getImage, Image } from "astro:assets";
import type { Artwork } from "@/data/artworks";

type Props = {
  artworks: Artwork[];
};

const { artworks } = Astro.props;

// Las medidas vienen como "alto x ancho cm". Usamos el ancho real para que
// las obras se vean a escala entre sí, como colgadas en una misma pared.
const widthInCm = (dimensions: string) => {
  const numbers = dimensions.match(/\d+(?:[.,]\d+)?/g)?.map((n) => Number(n.replace(",", ".")));
  return numbers?.[1] ?? numbers?.[0] ?? 80;
};

const viewerData = await Promise.all(
  artworks.map(async (artwork) => {
    const full = await getImage({
      src: artwork.image,
      widths: [1200, 1800, 2400],
      format: "webp"
    });
    return {
      slug: artwork.slug,
      src: full.src,
      srcset: full.srcSet.attribute,
      alt: artwork.alt,
      title: artwork.title,
      year: artwork.year,
      technique: artwork.technique,
      techniqueEn: artwork.techniqueEn,
      dimensions: artwork.dimensions,
      description: artwork.description,
      descriptionEn: artwork.descriptionEn
    };
  })
);
---

<section class="section page" id="obra" aria-labelledby="obra-title">
  <header class="section__head">
    <h2 class="section__title" id="obra-title">
      <span data-lang="es">Obra</span>
      <span data-lang="en">Work</span>
    </h2>
    <p class="section__intro">
      <span data-lang="es">
        Las obras se muestran a escala entre sí. Pulsa una para verla en grande.
      </span>
      <span data-lang="en">
        Works are shown at scale relative to each other. Select one to see it large.
      </span>
    </p>
  </header>

  <ul class="wall">
    {
      artworks.map((artwork, index) => (
        <li class="wall__item" style={`--w:${widthInCm(artwork.dimensions)}`}>
          <button
            class="wall__button"
            type="button"
            data-open-work={index}
            aria-haspopup="dialog"
          >
            <Image
              src={artwork.thumbnail}
              alt={artwork.alt}
              widths={[360, 560, 800, 1100]}
              sizes="(max-width: 700px) 90vw, 34vw"
              loading={index < 4 ? "eager" : "lazy"}
            />
          </button>
          <p class="wall__label">
            <span class="wall__title">{artwork.title}</span>, {artwork.year}
            <br />
            <span data-lang="es">{artwork.technique}</span>
            <span data-lang="en">{artwork.techniqueEn}</span>
            <br />
            {artwork.dimensions}
          </p>
        </li>
      ))
    }
  </ul>
</section>

<dialog class="viewer" aria-labelledby="viewer-title" data-viewer>
  <div class="viewer__layout">
    <figure class="viewer__figure">
      <img class="viewer__image" alt="" data-viewer-image />
    </figure>
    <div class="viewer__info">
      <div class="viewer__top">
        <p class="viewer__count" data-viewer-count></p>
        <button class="viewer__close" type="button" data-viewer-close>
          <span data-lang="es">Cerrar</span>
          <span data-lang="en">Close</span>
        </button>
      </div>
      <h3 class="viewer__title" id="viewer-title" data-viewer-title></h3>
      <dl class="viewer__facts">
        <dt><span data-lang="es">Año</span><span data-lang="en">Year</span></dt>
        <dd data-viewer-year></dd>
        <dt><span data-lang="es">Técnica</span><span data-lang="en">Medium</span></dt>
        <dd>
          <span data-lang="es" data-viewer-technique></span>
          <span data-lang="en" data-viewer-technique-en></span>
        </dd>
        <dt><span data-lang="es">Medidas</span><span data-lang="en">Size</span></dt>
        <dd data-viewer-dimensions></dd>
      </dl>
      <p class="viewer__description">
        <span data-lang="es" data-viewer-description></span>
        <span data-lang="en" data-viewer-description-en></span>
      </p>
      <div class="viewer__nav">
        <button type="button" data-viewer-prev>
          <span data-lang="es">Anterior</span>
          <span data-lang="en">Previous</span>
        </button>
        <button type="button" data-viewer-next>
          <span data-lang="es">Siguiente</span>
          <span data-lang="en">Next</span>
        </button>
      </div>
    </div>
  </div>
</dialog>

<script is:inline type="application/json" id="viewer-data" set:html={JSON.stringify(viewerData)} />

<script>
  import "@/scripts/viewer.ts";
</script>

<style>
  .wall {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: var(--space-4) clamp(1.5rem, 4vw, 4rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .wall__item {
    --cm: 0.16vw;
    width: max(7.5rem, calc(var(--w) * var(--cm)));
    max-width: 100%;
  }

  .wall__button {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
  }

  .wall__button img {
    width: 100%;
    height: auto;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.12);
    transition: transform var(--duration-short) var(--ease-editorial);
  }

  .wall__button:hover img {
    transform: translateY(-3px);
  }

  .wall__label {
    margin: 0.7rem 0 0;
    color: var(--color-muted);
    font-size: var(--text-label);
    line-height: 1.4;
  }

  .wall__title {
    color: var(--color-ink);
    font-style: italic;
  }

  @media (max-width: 700px) {
    .wall {
      gap: var(--space-4) 1rem;
    }

    .wall__item {
      --cm: 0.42vw;
      width: max(42%, calc(var(--w) * var(--cm)));
    }
  }

  .viewer {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--color-paper);
    color: var(--color-ink);
  }

  .viewer::backdrop {
    background: var(--color-paper);
  }

  .viewer__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 22rem;
    grid-template-rows: minmax(0, 1fr);
    height: 100%;
  }

  .viewer__figure {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 0;
    min-height: 0;
    height: 100%;
    margin: 0;
    padding: clamp(1rem, 4vw, 3rem);
    overflow: hidden;
  }

  .viewer__image {
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.15);
  }

  .viewer__info {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-3);
    border-left: 1px solid var(--color-line);
    overflow-y: auto;
  }

  .viewer__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .viewer__count {
    margin: 0;
    color: var(--color-muted);
    font-size: var(--text-small);
    font-variant-numeric: tabular-nums;
  }

  .viewer__title {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 500;
    font-style: italic;
    line-height: 1.2;
  }

  .viewer__facts {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.4rem 1rem;
    margin: 0;
    font-size: var(--text-small);
  }

  .viewer__facts dt {
    color: var(--color-muted);
  }

  .viewer__facts dd {
    margin: 0;
  }

  .viewer__description {
    margin: 0;
    font-size: var(--text-small);
  }

  .viewer__nav {
    display: flex;
    gap: var(--space-2);
    margin-top: auto;
  }

  .viewer button {
    min-height: 2.75rem;
    padding: 0 1rem;
    border: 1px solid var(--color-ink);
    background: transparent;
    color: var(--color-ink);
    cursor: pointer;
  }

  .viewer button:hover {
    background: var(--color-ink);
    color: var(--color-paper);
  }

  .viewer__nav button {
    flex: 1;
  }

  @media (max-width: 900px) {
    .viewer__layout {
      grid-template-columns: 1fr;
      grid-template-rows: minmax(0, 1fr) auto;
    }

    .viewer__info {
      gap: var(--space-2);
      max-height: 45svh;
      border-top: 1px solid var(--color-line);
      border-left: 0;
    }

    .viewer__top {
      order: -1;
    }
  }
</style>
