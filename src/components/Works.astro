---
import { getImage } from "astro:assets";
import type { Artwork } from "@/data/artworks";

type Props = {
  artworks: Artwork[];
};

const { artworks } = Astro.props;

// Dos tamaños por obra: miniatura para la rueda/lista y grande para la ficha.
const works = await Promise.all(
  artworks.map(async (artwork) => {
    const thumb = await getImage({ src: artwork.thumbnail, width: 1000, format: "webp" });
    const full = await getImage({
      src: artwork.image,
      widths: [1000, 1600, 2200],
      format: "webp"
    });
    return {
      slug: artwork.slug,
      thumb: thumb.src,
      thumbW: thumb.attributes.width as number,
      thumbH: thumb.attributes.height as number,
      full: full.src,
      fullSrcset: full.srcSet.attribute,
      alt: artwork.alt,
      title: artwork.title,
      year: artwork.year,
      technique: artwork.technique,
      techniqueEn: artwork.techniqueEn,
      dimensions: artwork.dimensions,
      description: artwork.description,
      descriptionEn: artwork.descriptionEn,
      process: artwork.processVideo ?? ""
    };
  })
);

const first = works[0]!;
const pad = (n: number) => String(n).padStart(2, "0");
---

<section
  class="works"
  id="obra"
  data-header="dark"
  data-works
  data-mode="wheel"
  style={`--count:${works.length}`}
  aria-labelledby="works-heading"
>
  <h2 class="sr-only" id="works-heading">
    <span data-lang="es">Obra</span><span data-lang="en">Work</span>
  </h2>

  <div class="works__stage">
    <div class="works__switch" role="group" aria-label="Modo de vista" data-aria-label-en="View mode">
      <button type="button" data-mode-button="wheel" aria-pressed="true">
        <span data-lang="es">Galería</span><span data-lang="en">Gallery</span></button
      >,
      <button type="button" data-mode-button="list" aria-pressed="false">
        <span data-lang="es">Lista</span><span data-lang="en">List</span>
      </button>
    </div>

    <button type="button" class="works__open" data-open-current aria-haspopup="dialog">
      <span data-lang="es">Ver ficha</span><span data-lang="en">View details</span> →
    </button>

    <!-- Pie de foto editorial de la obra que está en el centro. -->
    <div class="works__caption" aria-live="polite">
      <p class="works__fig num">
        Fig. <span class="mask"><span data-now="num">{pad(1)}</span></span>
      </p>
      <p class="works__title"><span class="mask"><span data-now="title">{first.title}</span></span></p>
      <p class="works__data">
        <span class="mask"
          ><span data-now="data"
            >{first.year} · <span data-lang="es">{first.technique}</span><span data-lang="en"
              >{first.techniqueEn}</span
            > · {first.dimensions}</span
          ></span
        >
      </p>
    </div>

    <p class="works__counter num" aria-hidden="true">
      <span class="mask"><span data-now="count">{pad(1)}</span></span><span class="works__total">/{pad(works.length)}</span>
    </p>

    <ul class="wheel" data-wheel>
      {
        works.map((work, index) => (
          <li class="wheel__item" style={`--i:${index}`} data-wheel-item>
            <button
              type="button"
              class="wheel__card"
              data-open-work={index}
              aria-haspopup="dialog"
              aria-label={work.title}
            >
              <img
                src={work.thumb}
                width={work.thumbW}
                height={work.thumbH}
                alt=""
                loading={index < 5 ? "eager" : "lazy"}
                decoding="async"
              />
            </button>
          </li>
        ))
      }
    </ul>

    <div class="list" data-list>
      <ol class="list__rows">
        {
          works.map((work, index) => (
            <li>
              <button type="button" class="list__row" data-open-work={index} data-list-row={index} aria-haspopup="dialog">
                <span class="num">{index + 1}</span>
                <span class="list__title">{work.title}</span>
                <span class="list__meta">
                  <span data-lang="es">{work.technique}</span>
                  <span data-lang="en">{work.techniqueEn}</span>
                </span>
                <span class="list__meta num">{work.dimensions}</span>
                <span class="list__meta num">{work.year}</span>
              </button>
            </li>
          ))
        }
      </ol>
      <figure class="list__preview" aria-hidden="true">
        <img src={first.thumb} alt="" data-list-preview />
      </figure>
    </div>

  </div>
</section>

<dialog class="sheet" aria-labelledby="sheet-title" data-sheet>
  <div class="sheet__panel">
    <div class="sheet__bar">
      <span class="num" data-sheet="count"></span>
      <div class="sheet__actions">
        <button type="button" data-sheet-prev>
          <span data-lang="es">Anterior</span><span data-lang="en">Previous</span>
        </button>
        <button type="button" data-sheet-next>
          <span data-lang="es">Siguiente</span><span data-lang="en">Next</span>
        </button>
        <button type="button" data-sheet-close>
          <span data-lang="es">Cerrar</span><span data-lang="en">Close</span>
        </button>
      </div>
    </div>
    <div class="sheet__body">
      <figure class="sheet__figure">
        <img alt="" data-sheet="image" />
      </figure>
      <div class="sheet__info">
        <h3 class="sheet__title" id="sheet-title" data-sheet="title"></h3>
        <dl class="sheet__facts">
          <dt><span data-lang="es">Año</span><span data-lang="en">Year</span></dt>
          <dd data-sheet="year"></dd>
          <dt><span data-lang="es">Técnica</span><span data-lang="en">Medium</span></dt>
          <dd>
            <span data-lang="es" data-sheet="technique"></span>
            <span data-lang="en" data-sheet="techniqueEn"></span>
          </dd>
          <dt><span data-lang="es">Medidas</span><span data-lang="en">Size</span></dt>
          <dd data-sheet="dimensions"></dd>
        </dl>
        <p class="sheet__description">
          <span data-lang="es" data-sheet="description"></span>
          <span data-lang="en" data-sheet="descriptionEn"></span>
        </p>
        <!-- Solo en obras con vídeo de proceso: un detalle pequeño en trama de imprenta. -->
        <figure class="sheet__process" data-sheet-process hidden>
          <div class="sheet__process-frame">
            <img alt="" data-sheet-process-poster />
            <canvas aria-hidden="true" data-sheet-process-canvas></canvas>
            <video muted loop playsinline preload="none" tabindex="-1" aria-hidden="true" data-sheet-process-video></video>
          </div>
          <figcaption>
            <span data-lang="es">En proceso, en el taller</span>
            <span data-lang="en">In progress, in the studio</span>
          </figcaption>
        </figure>
      </div>
    </div>
  </div>
</dialog>

<script is:inline type="application/json" id="works-data" set:html={JSON.stringify(works)} />

<script>
  import "@/scripts/works.ts";
</script>

<style>
  /* Galería editorial: fondo blanco, una obra protagonista en el centro y sus
     vecinas lejos, pequeñas y en gris. Al hacer scroll se pasa de una en una con
     un "clic" (ver works.ts). */
  .works {
    position: relative;
    height: calc(var(--count) * 42svh + 100svh);
    background: var(--white);
    color: var(--black);
  }

  .works[data-mode="list"] {
    height: 100svh;
    min-height: 40rem;
  }

  .works__stage {
    position: sticky;
    top: 0;
    height: 100svh;
    min-height: 34rem;
    overflow: hidden;
  }

  .works[data-mode="list"] .works__stage {
    min-height: 40rem;
  }

  .works__switch {
    position: absolute;
    top: 5rem;
    left: var(--gutter);
    z-index: 200;
    font-size: var(--text-small);
    font-weight: 500;
    color: rgb(0 0 0 / 0.55);
  }

  .works__switch button {
    padding: 0.25rem 0;
    border: 0;
    background: none;
    color: inherit;
    font-weight: 500;
  }

  .works__switch button[aria-pressed="true"] {
    color: var(--black);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .works__open {
    position: absolute;
    top: 5rem;
    right: var(--gutter);
    z-index: 200;
    padding: 0.25rem 0;
    border: 0;
    background: none;
    color: var(--red);
    font-size: var(--text-small);
    font-weight: 600;
  }

  .works__open:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  /* Pie de foto: "Fig. 03", título en serif, rayita roja y datos. */
  .works__caption {
    position: absolute;
    left: var(--gutter);
    bottom: var(--gutter);
    z-index: 200;
    max-width: min(46rem, 62vw);
  }

  .works__fig {
    margin: 0;
    font-size: var(--text-small);
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .works__fig [data-now="num"] {
    color: var(--red);
  }

  /* Alto fijo para dos líneas: el título se apoya abajo y "Fig." no se mueve
     al cambiar entre títulos cortos y largos. */
  .works__title {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: calc(2 * 1.02em + 0.7rem + 3px);
    margin: 0.35rem 0 0;
    font-family: var(--font-serif);
    font-size: clamp(1.9rem, 3.2vw, 3.4rem);
    font-weight: 400;
    line-height: 1.02;
    letter-spacing: -0.01em;
  }

  .works__title::after {
    content: "";
    display: block;
    width: 2.2rem;
    height: 3px;
    margin-top: 0.7rem;
    background: var(--red);
  }

  /* Una sola línea (las técnicas largas se cortan con "…"; están completas en la ficha). */
  .works__data {
    overflow: hidden;
    margin: 0.6rem 0 0;
    white-space: nowrap;
    color: #555;
    font-size: var(--text-small);
    font-weight: 500;
  }

  .works__counter {
    position: absolute;
    right: var(--gutter);
    bottom: var(--gutter);
    z-index: 200;
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(2rem, 3.4vw, 3.6rem);
    line-height: 1;
  }

  .works__counter [data-now="count"] {
    color: var(--red);
  }

  .works__total {
    color: #9a9a9a;
    font-size: 0.45em;
  }

  .works[data-mode="list"] :is(.works__caption, .works__counter, .works__open) {
    display: none;
  }

  .mask {
    display: inline-block;
    overflow: hidden;
    vertical-align: top;
    padding-bottom: 0.08em;
  }

  .mask > span {
    display: inline-block;
  }

  .works__data .mask {
    max-width: 100%;
  }

  .works__data [data-now="data"] {
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    vertical-align: top;
  }

  /* --- Galería: obras en línea recta --- */
  .wheel {
    --strip-h: calc(max(100svh, 34rem) - 19rem - var(--gutter));
    position: absolute;
    inset: 9.5rem 0 calc(var(--gutter) + 9.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .works[data-mode="list"] .wheel {
    display: none;
  }

  .wheel__item {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    will-change: transform, opacity;
  }

  .wheel__card {
    display: block;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    pointer-events: auto;
  }

  /* La obra entera, con sus proporciones reales. */
  .wheel__card img {
    display: block;
    width: auto;
    height: auto;
    max-width: 46vw;
    max-height: var(--strip-h);
    object-fit: contain;
    box-shadow: 0 0.6rem 1.6rem rgb(0 0 0 / 0.08);
  }

  .wheel__card:focus-visible {
    outline: 3px solid var(--red);
    outline-offset: 4px;
  }

  /* --- Lista --- */
  .list {
    display: none;
  }

  .works[data-mode="list"] .list {
    position: absolute;
    inset: auto var(--gutter) var(--space-4);
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(10rem, 16vw, 15rem);
    align-items: end;
    gap: var(--space-3);
  }

  .list__rows {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .list__row {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 2.2fr) minmax(0, 2fr) minmax(0, 1fr) 4rem;
    gap: var(--space-2);
    width: 100%;
    padding: 0.12rem 0;
    border: 0;
    background: none;
    color: rgb(0 0 0 / 0.66);
    font-size: var(--text-small);
    font-weight: 500;
    text-align: left;
  }

  .list__row:hover,
  .list__row:focus-visible,
  .list__row.is-current {
    color: var(--black);
  }

  .list__title {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .list__meta {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .list__preview {
    display: flex;
    align-items: flex-end;
    justify-content: flex-end;
    height: clamp(12rem, 30svh, 20rem);
    margin: 0;
  }

  .list__preview img {
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  /* --- Ficha (dialog) --- */
  .sheet {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--black);
  }

  .sheet::backdrop {
    background: rgb(0 0 0 / 0.35);
    backdrop-filter: blur(14px);
  }

  .sheet__panel {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    height: min(72svh, 46rem);
    padding: var(--gutter);
    background: var(--white);
    animation: sheet-in 650ms var(--ease-out);
  }

  @keyframes sheet-in {
    from {
      transform: translateY(-100%);
    }
  }

  .sheet__bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-left: 13rem;
    font-size: var(--text-small);
    font-weight: 500;
  }

  .sheet__actions {
    display: flex;
    gap: var(--space-2);
  }

  .sheet__actions button {
    padding: 0.4rem 0;
    border: 0;
    background: none;
    font-weight: 500;
  }

  .sheet__actions button:hover {
    text-decoration: underline;
  }

  .sheet__body {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: var(--space-4);
    min-height: 0;
    padding-top: var(--space-2);
  }

  .sheet__figure {
    display: flex;
    min-height: 0;
    margin: 0;
  }

  .sheet__figure img {
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    object-position: left top;
  }

  .sheet__info {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    max-width: 34rem;
    overflow-y: auto;
  }

  .sheet__title {
    margin: 0;
    font-size: clamp(1.8rem, 3vw, 3.2rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.035em;
  }

  .sheet__facts {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: 0.35rem 1rem;
    margin: 0;
    font-size: var(--text-small);
    font-weight: 500;
  }

  .sheet__facts dt {
    color: var(--color-muted);
  }

  .sheet__facts dd {
    margin: 0;
  }

  .sheet__description {
    margin: 0;
    font-size: var(--text-small);
    font-weight: 500;
    line-height: 1.3;
  }

  .sheet__process {
    margin: 0;
  }

  .sheet__process[hidden] {
    display: none;
  }

  .sheet__process-frame {
    position: relative;
    width: clamp(7.5rem, 10vw, 10rem);
    aspect-ratio: 240 / 438;
  }

  .sheet__process-frame img,
  .sheet__process-frame canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* Sin WebGL: el póster en sepia suave. Con WebGL el lienzo lo tapa. */
  .sheet__process-frame img {
    object-fit: cover;
    filter: grayscale(1) sepia(0.6) contrast(0.9) brightness(1.1);
    opacity: 0.8;
  }

  .sheet__process.is-halftone img {
    visibility: hidden;
  }

  .sheet__process:not(.is-halftone) canvas {
    display: none;
  }

  .sheet__process video {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .sheet__process figcaption {
    margin-top: var(--space-1);
    color: var(--color-muted);
    font-size: var(--text-label);
    font-weight: 500;
  }

  @media (max-width: 760px) {
    .works__switch,
    .works__open {
      top: 4.5rem;
    }

    .wheel {
      --strip-h: calc(max(100svh, 34rem) - 16.5rem - var(--gutter));
      inset: 7.5rem 0 calc(var(--gutter) + 9rem);
    }

    .wheel__card img {
      max-width: 78vw;
    }

    .works__caption {
      max-width: 72vw;
    }

    .works__title {
      min-height: calc(3 * 1.02em + 0.7rem + 3px);
      font-size: 1.7rem;
    }

    .works__counter {
      font-size: 1.8rem;
    }

    .works[data-mode="list"] .list {
      grid-template-columns: 1fr;
    }

    .list__row {
      grid-template-columns: 1.75rem minmax(0, 1fr) 3rem;
    }

    .list__row .list__meta:not(:last-child) {
      display: none;
    }

    /* En móvil la vista previa va encima de la lista, en el hueco libre. */
    .works[data-mode="list"] .list {
      grid-template-rows: minmax(0, 1fr) auto;
      top: 10rem;
    }

    .list__preview {
      order: -1;
      justify-content: flex-start;
      height: 100%;
      min-height: 8rem;
    }

    .sheet__panel {
      height: 88svh;
    }

    .sheet__bar {
      padding-left: 0;
    }

    .sheet__body {
      grid-template-columns: 1fr;
      grid-template-rows: minmax(0, 1fr) auto;
      gap: var(--space-2);
    }

    .sheet__figure img {
      object-position: center;
      margin-inline: auto;
    }

    .sheet__info {
      max-height: 38svh;
    }
  }
</style>
