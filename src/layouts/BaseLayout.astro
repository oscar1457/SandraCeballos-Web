---
import { site } from "@/data/site";
import "@fontsource-variable/inter-tight";
import "@fontsource/dm-serif-display/latin.css";
import "@fontsource/dm-serif-display/latin-ext.css";
import "@/styles/global.css";
import interTightUrl from "@fontsource-variable/inter-tight/files/inter-tight-latin-wght-normal.woff2?url";
import dmSerifUrl from "@fontsource/dm-serif-display/files/dm-serif-display-latin-400-normal.woff2?url";

type Props = {
  title?: string;
  description?: string;
};

const title = Astro.props.title ?? site.title;
const description = Astro.props.description ?? site.description;
const canonical = new URL(Astro.url.pathname, site.url).toString();
const ogImage = new URL(site.ogImage.src, site.url).toString();
// Datos para buscadores (schema.org): quién es Sandra, el espacio que fundó y
// la web. Solo datos públicos y comprobados (sin dirección exacta).
const sandraId = `${site.url}/#sandra-ceballos`;
const aglutinadorId = `${site.url}/aglutinador/#espacio-aglutinador`;
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": sandraId,
      name: site.name,
      // Nombre completo, fecha y lugar de nacimiento tal como constan en Wikipedia.
      alternateName: "Sandra Amelia Ceballos Obaya",
      birthDate: "1961-03-21",
      birthPlace: { "@type": "Place", name: "Guantánamo, Cuba" },
      jobTitle: ["Artista visual", "Curadora"],
      description: site.biography,
      nationality: { "@type": "Country", name: "Cuba" },
      alumniOf: { "@type": "EducationalOrganization", name: "Academia Nacional de Bellas Artes San Alejandro" },
      award: "Beca CINTAS en artes visuales, 2022",
      url: site.url,
      image: ogImage,
      sameAs: site.socialProfiles,
      founder: { "@id": aglutinadorId }
    },
    {
      "@type": "ArtGallery",
      "@id": aglutinadorId,
      name: "Espacio Aglutinador",
      description: "Galería de arte independiente fundada en La Habana en 1994.",
      foundingDate: "1994",
      founder: [{ "@id": sandraId }, { "@type": "Person", name: "Ezequiel Suárez" }],
      address: { "@type": "PostalAddress", addressLocality: "La Habana", addressCountry: "CU" },
      url: `${site.url}/aglutinador/`,
      sameAs: ["https://www.espacioaglutinador.com/"]
    },
    {
      "@type": "WebSite",
      "@id": `${site.url}/#web`,
      name: site.name,
      url: site.url,
      inLanguage: ["es", "en"],
      about: { "@id": sandraId }
    }
  ]
};
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={interTightUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={dmSerifUrl} as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <a class="skip-link" href="#contenido">
      <span data-lang="es">Saltar al contenido</span>
      <span data-lang="en">Skip to content</span>
    </a>
    <slot />
  </body>
</html>
