---
import { getImage, Image } from "astro:assets";
import AglutinadorLayout from "@/layouts/AglutinadorLayout.astro";
import { archivePhotos } from "@/data/aglutinador";

const photos = await Promise.all(
  archivePhotos.map(async (photo) => {
    const full = await getImage({ src: photo.image, widths: [900, 1400, 2000], format: "webp" });
    return { ...photo, full: full.src, srcset: full.srcSet.attribute };
  })
);
const viewerData = photos.map(({ full, srcset, caption, captionEn }) => ({ full, srcset, caption, captionEn }));
---

<AglutinadorLayout
  title="Archivo de Espacio Aglutinador · Fotografías y documentos"
  description="Fotografías y documentos del archivo de Espacio Aglutinador, La Habana."
  current="archivo"
  background="#dad6d3"
>
  <h1 class="sr-only">
    <span data-lang="es">Archivo de Espacio Aglutinador</span>
    <span data-lang="en">Espacio Aglutinador archive</span>
  </h1>
  <p class="count num" aria-hidden="true">{photos.length}</p>

  <ul class="grid">
    {
      photos.map((photo, index) => (
        <li>
          <button type="button" class="grid__item" data-photo={index} aria-haspopup="dialog">
            <Image
              src={photo.image}
              alt=""
              widths={[400, 700, 1000]}
              sizes="(max-width: 620px) 50vw, 25vw"
              loading={index < 8 ? "eager" : "lazy"}
            />
            <span class="grid__caption">
              <span data-lang="es">{photo.caption}</span>
              <span data-lang="en">{photo.captionEn}</span>
            </span>
          </button>
        </li>
      ))
    }
  </ul>

  <dialog class="viewer" aria-label="Fotografía" data-aria-label-en="Photograph" data-viewer>
    <div class="viewer__bar">
      <span class="num" data-viewer-count></span>
      <span class="viewer__actions">
        <button type="button" data-viewer-prev><span data-lang="es">Anterior</span><span data-lang="en">Previous</span></button>
        <button type="button" data-viewer-next><span data-lang="es">Siguiente</span><span data-lang="en">Next</span></button>
        <button type="button" data-viewer-close><span data-lang="es">Cerrar</span><span data-lang="en">Close</span></button>
      </span>
    </div>
    <figure class="viewer__figure">
      <img alt="" data-viewer-img />
      <figcaption>
        <span data-lang="es" data-viewer-caption></span>
        <span data-lang="en" data-viewer-caption-en></span>
      </figcaption>
    </figure>
  </dialog>

  <script is:inline type="application/json" id="archive-data" set:html={JSON.stringify(viewerData)} />
</AglutinadorLayout>

<script>
  import "@/scripts/agl-smooth.ts";

  type Photo = { full: string; srcset: string; caption: string; captionEn: string };
  const dialog = document.querySelector<HTMLDialogElement>("[data-viewer]");
  const data = JSON.parse(document.getElementById("archive-data")?.textContent ?? "[]") as Photo[];
  if (dialog && data.length) {
    const img = dialog.querySelector<HTMLImageElement>("[data-viewer-img]")!;
    const cap = dialog.querySelector<HTMLElement>("[data-viewer-caption]")!;
    const capEn = dialog.querySelector<HTMLElement>("[data-viewer-caption-en]")!;
    const count = dialog.querySelector<HTMLElement>("[data-viewer-count]")!;
    let index = 0;
    let opener: HTMLElement | null = null;
    const show = (i: number) => {
      index = (i + data.length) % data.length;
      const photo = data[index]!;
      img.src = photo.full;
      img.srcset = photo.srcset;
      img.sizes = "100vw";
      img.alt = photo.caption;
      cap.textContent = photo.caption;
      capEn.textContent = photo.captionEn;
      count.textContent = `${index + 1} / ${data.length}`;
    };
    document.querySelectorAll<HTMLButtonElement>("[data-photo]").forEach((button) =>
      button.addEventListener("click", () => {
        opener = button;
        show(Number(button.dataset.photo));
        dialog.showModal();
      })
    );
    dialog.querySelector("[data-viewer-prev]")?.addEventListener("click", () => show(index - 1));
    dialog.querySelector("[data-viewer-next]")?.addEventListener("click", () => show(index + 1));
    dialog.querySelector("[data-viewer-close]")?.addEventListener("click", () => dialog.close());
    dialog.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft") show(index - 1);
      if (event.key === "ArrowRight") show(index + 1);
    });
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog.addEventListener("close", () => opener?.focus());
  }
</script>

<style>
  .count {
    position: fixed;
    top: var(--gutter);
    left: var(--gutter);
    z-index: 5;
    margin: 0;
    font-size: clamp(0.85rem, 1vw, 1rem);
    font-weight: 600;
  }

  /* Cuadrícula como un índice: las fotos se ven enteras, sin recortar. */
  .grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    align-items: end;
    gap: var(--space-4) var(--gutter);
    margin: 0;
    padding: calc(var(--gutter) * 4) var(--gutter) var(--space-4);
    list-style: none;
  }

  .grid__item {
    display: grid;
    gap: 0.5rem;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    font-size: clamp(0.85rem, 1vw, 1rem);
    font-weight: 600;
    text-align: left;
    cursor: zoom-in;
  }

  .grid__item img {
    width: 100%;
    height: auto;
    transition: opacity 250ms var(--ease);
  }

  .grid__item:hover img {
    opacity: 0.85;
  }

  .viewer {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: var(--gutter);
    border: 0;
    background: #dad6d3;
    color: var(--black);
    font-weight: 600;
  }

  .viewer[open] {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    gap: var(--gutter);
  }

  .viewer::backdrop {
    background: #dad6d3;
  }

  .viewer__bar {
    display: flex;
    justify-content: space-between;
    font-size: clamp(0.85rem, 1vw, 1rem);
  }

  .viewer__actions {
    display: flex;
    gap: var(--space-2);
  }

  .viewer__actions button {
    padding: 0.3rem 0;
    border: 0;
    background: none;
    font-weight: 600;
  }

  .viewer__actions button:hover {
    text-decoration: underline;
  }

  .viewer__figure {
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    gap: 0.6rem;
    min-height: 0;
    margin: 0;
  }

  .viewer__figure img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .viewer__figure figcaption {
    text-align: center;
  }

  @media (max-width: 620px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-3) var(--gutter);
    }
  }
</style>
