---
import AglutinadorLayout from "@/layouts/AglutinadorLayout.astro";
import { participants } from "@/data/aglutinador";
---

<AglutinadorLayout
  title="Espacio Aglutinador | Sandra Ceballos"
  description="Espacio Aglutinador, espacio de arte independiente fundado en La Habana en 1994. Personas que han trabajado en él."
  current="inicio"
>
  <h1 class="sr-only">
    <span data-lang="es">Espacio Aglutinador: personas que han trabajado en el espacio desde 1994</span>
    <span data-lang="en">Espacio Aglutinador: people who have worked in the space since 1994</span>
  </h1>

  <p class="intro">
    <span data-lang="es">
      Espacio Aglutinador, La Habana, desde 1994. Artistas, curadores y colaboradores que han pasado
      por el espacio.
    </span>
    <span data-lang="en">
      Espacio Aglutinador, Havana, since 1994. Artists, curators and collaborators who have been part
      of the space.
    </span>
  </p>

  <!-- Lista de nombres que sube sola en bucle. La segunda copia solo sirve para
       que el bucle no tenga cortes; los lectores de pantalla la ignoran. -->
  <div class="names" data-names tabindex="0" aria-label="Lista de personas" data-aria-label-en="List of people">
    <div class="names__spacer" data-names-spacer aria-hidden="true"></div>
    {
      [0, 1].map((copy) => (
        <ul class="names__list" aria-hidden={copy === 1 ? "true" : undefined} data-names-list>
          {participants.map((person) => (
            <li class="names__row">
              <span class="names__name">{person.name}</span>
              <span class="names__role">
                <span data-lang="es">{person.role}</span>
                <span data-lang="en">{person.roleEn}</span>
              </span>
            </li>
          ))}
        </ul>
      ))
    }
  </div>
</AglutinadorLayout>

<script>
  // Desplazamiento automático hacia arriba, en bucle y sin pausas. La rueda o el
  // dedo de la persona adelantan o atrasan la lista, pero el movimiento nunca se
  // detiene. Con movimiento reducido no se mueve sola y el scroll es el normal.
  const box = document.querySelector<HTMLElement>("[data-names]");
  const list = document.querySelector<HTMLElement>("[data-names-list]");
  const spacer = document.querySelector<HTMLElement>("[data-names-spacer]");
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (box && list && spacer && !reduced) {
    // Velocidad proporcional a la altura de la pantalla (unos 125 px/s en un portátil).
    const speed = () => Math.max(90, box.clientHeight * 0.15);
    let last = performance.now();
    let position = box.scrollTop; // posición exacta (scrollTop se redondea)
    let pending = 0; // desplazamiento manual que falta por aplicar, con suavizado
    let looped = false;
    let written = -1;

    // Las dos listas son idénticas: al pasar el final de la primera (o volver
    // por encima de su inicio, una vez dada la primera vuelta) se salta
    // exactamente su altura y el cambio no se ve.
    const wrap = (value: number) => {
      const height = list.offsetHeight;
      const top = spacer.offsetHeight;
      if (height <= 0) return Math.max(0, value);
      if (value >= top + height) {
        looped = true;
        return value - height;
      }
      if (looped && value < top) return value + height;
      return Math.max(0, value);
    };

    // Rueda: se suma al recorrido en vez de dejar que el navegador mueva la caja.
    box.addEventListener(
      "wheel",
      (event) => {
        if (event.ctrlKey) return; // zoom con el trackpad
        event.preventDefault();
        const unit = event.deltaMode === 1 ? 16 : event.deltaMode === 2 ? box.clientHeight : 1;
        pending += event.deltaY * unit;
      },
      { passive: false }
    );

    // Tacto: se sigue al dedo y al soltar queda algo de inercia.
    let touchY = 0;
    let touchTime = 0;
    let velocity = 0;
    box.addEventListener("touchstart", (event) => {
      const touch = event.touches[0];
      if (!touch) return;
      touchY = touch.clientY;
      touchTime = performance.now();
      velocity = 0;
      pending = 0;
    }, { passive: true });
    box.addEventListener("touchmove", (event) => {
      const touch = event.touches[0];
      if (!touch) return;
      event.preventDefault();
      const y = touch.clientY;
      const now = performance.now();
      const delta = touchY - y;
      position = wrap(position + delta);
      velocity = delta / Math.max(now - touchTime, 1);
      touchY = y;
      touchTime = now;
    }, { passive: false });
    box.addEventListener("touchend", () => {
      pending += velocity * 320;
      velocity = 0;
    }, { passive: true });

    // Si algo mueve la caja por otra vía (barra de desplazamiento, teclado),
    // se toma esa posición como nueva base.
    box.addEventListener("scroll", () => {
      if (Math.abs(box.scrollTop - written) > 1) {
        position = wrap(box.scrollTop);
        pending = 0;
      }
    });

    const tick = (now: number) => {
      const dt = Math.min(now - last, 100) / 1000;
      last = now;
      if (!document.hidden) {
        const step = pending * (1 - Math.exp(-dt * 10));
        pending -= step;
        if (Math.abs(pending) < 0.1) pending = 0;
        position = wrap(position + speed() * dt + step);
        box.scrollTop = position;
        written = box.scrollTop;
      }
      requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  }
</script>

<style>
  .intro {
    position: fixed;
    top: var(--gutter);
    left: var(--gutter);
    z-index: 5;
    max-width: 26rem;
    margin: 0;
    font-size: clamp(0.85rem, 1vw, 1rem);
    font-weight: 600;
    line-height: 1.2;
  }

  .names {
    position: fixed;
    inset: 0 0 var(--bar-h);
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: none;
    -webkit-mask-image: linear-gradient(180deg, transparent 0, #000 22%, #000 100%);
    mask-image: linear-gradient(180deg, transparent 0, #000 22%, #000 100%);
  }

  .names::-webkit-scrollbar {
    display: none;
  }

  .names:focus-visible {
    outline: 2px solid var(--black);
    outline-offset: -4px;
  }

  .names__list {
    margin: 0;
    padding: 0 var(--gutter);
    list-style: none;
  }

  /* Solo el hueco que ocupa el degradado de arriba: el primer nombre aparece
     ya entero, sin pantalla vacía al entrar. */
  .names__spacer {
    height: calc((100svh - var(--bar-h)) * 0.22);
  }

  .names__row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--gutter);
    font-size: clamp(1.9rem, 3.4vw, 5.6rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.03em;
    transition: opacity 250ms var(--ease);
  }

  /* Cada nombre y cada función ocupan una sola línea: así no quedan huecos
     entre filas. El tamaño de letra está calculado para que quepa la más larga. */
  .names__name,
  .names__role {
    overflow: hidden;
    padding-bottom: 0.08em;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* Al pasar el ratón por la lista, la fila señalada destaca sobre las demás. */
  @media (hover: hover) {
    .names:hover .names__row {
      opacity: 0.25;
    }

    .names:hover .names__row:hover {
      opacity: 1;
    }
  }

  @media (max-width: 900px) {
    .intro {
      max-width: 15rem;
    }

    .names__row {
      grid-template-columns: 1fr;
      gap: 0;
      padding-bottom: 0.2em;
      font-size: clamp(1.6rem, 8.4vw, 3rem);
    }

    .names__role {
      color: #5a5a5a;
      font-size: 0.6em;
    }
  }
</style>
