---
import Career from "@/components/Career.astro";
import Contact from "@/components/Contact.astro";
import Footer from "@/components/Footer.astro";
import Intro from "@/components/Intro.astro";
import Publications from "@/components/Publications.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import Works from "@/components/Works.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { artworks } from "@/data/artworks";
import { site } from "@/data/site";

const formEndpoint = import.meta.env.PUBLIC_FORMSPREE_ENDPOINT ?? "";
---

<BaseLayout>
  <SiteHeader site={site} workCount={artworks.length} />
  <main id="contenido">
    <Intro site={site} />
    <Works artworks={artworks} />
    <Career />
    <Publications />
    <Contact site={site} endpoint={formEndpoint} />
  </main>
  <Footer site={site} />
  <script>
    import "@/scripts/language.ts";
    import "@/scripts/smooth.ts";
  </script>
</BaseLayout>
