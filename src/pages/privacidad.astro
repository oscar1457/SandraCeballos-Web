---
import LanguageSwitch from "@/components/LanguageSwitch.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { site } from "@/data/site";
---

<BaseLayout title={`Privacidad | ${site.name}`} description="Política de privacidad.">
  <main class="legal-page" id="contenido">
    <header class="legal-page__header">
      <a href="/#contacto">
        <span data-lang="es">Volver</span>
        <span data-lang="en">Back</span>
      </a>
      <LanguageSwitch />
    </header>

    <p class="legal-page__kicker">
      <span data-lang="es">Información legal</span>
      <span data-lang="en">Legal information</span>
    </p>
    <h1>
      <span data-lang="es">Política de privacidad</span>
      <span data-lang="en">Privacy policy</span>
    </h1>

    <section>
      <h2>
        <span data-lang="es">Responsable</span>
        <span data-lang="en">Controller</span>
      </h2>
      <p>
        <span data-lang="es">
          Esta web representa el portafolio de {site.name}. El correo de contacto es
          {" "}
          <a href={`mailto:${site.email}`}>{site.email}</a>.
        </span>
        <span data-lang="en">
          This website presents the portfolio of {site.name}. The contact email is
          {" "}
          <a href={`mailto:${site.email}`}>{site.email}</a>.
        </span>
      </p>
    </section>

    <section>
      <h2>
        <span data-lang="es">Datos recogidos</span>
        <span data-lang="en">Data collected</span>
      </h2>
      <p>
        <span data-lang="es">
          Si usas el formulario de contacto, se procesan los datos que escribes: nombre, correo
          electrónico, asunto opcional y mensaje. No se crea cuenta de usuario ni se usa CMS.
        </span>
        <span data-lang="en">
          If you use the contact form, the submitted data is processed: name, email address,
          optional subject and message. No user account or CMS is used.
        </span>
      </p>
    </section>

    <section>
      <h2>Formspree</h2>
      <p>
        <span data-lang="es">
          El formulario se envía mediante Formspree. Formspree actúa como proveedor técnico para
          entregar el mensaje al correo configurado por la propietaria del sitio.
        </span>
        <span data-lang="en">
          The form is sent through Formspree. Formspree acts as a technical provider to deliver the
          message to the email configured by the site owner.
        </span>
      </p>
    </section>

    <section>
      <h2>
        <span data-lang="es">Finalidad y conservación</span>
        <span data-lang="en">Purpose and retention</span>
      </h2>
      <p>
        <span data-lang="es">
          Los datos se usan únicamente para responder consultas sobre obra, exposiciones o
          colaboraciones. Los mensajes se conservarán solo durante el tiempo necesario para atender
          la comunicación.
        </span>
        <span data-lang="en">
          The data is used only to respond to inquiries about works, exhibitions or collaborations.
          Messages are kept only for as long as needed to handle the communication.
        </span>
      </p>
    </section>

    <section>
      <h2>
        <span data-lang="es">Derechos</span>
        <span data-lang="en">Rights</span>
      </h2>
      <p>
        <span data-lang="es">
          Puedes solicitar acceso, rectificación o eliminación de tus datos escribiendo a
          {" "}
          <a href={`mailto:${site.email}`}>{site.email}</a>.
        </span>
        <span data-lang="en">
          You may request access, correction or deletion of your data by writing to
          {" "}
          <a href={`mailto:${site.email}`}>{site.email}</a>.
        </span>
      </p>
    </section>
  </main>
  <script>
    import "@/scripts/language.ts";
  </script>
</BaseLayout>

<style>
  .legal-page {
    display: grid;
    gap: var(--space-3);
    width: min(100% - 2rem, 44rem);
    margin: 0 auto;
    padding: var(--space-3) 0 var(--space-5);
  }

  .legal-page__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }

  .legal-page__kicker,
  .legal-page h1,
  .legal-page h2,
  .legal-page p {
    margin: 0;
  }

  .legal-page__kicker {
    color: var(--color-muted);
    font-size: var(--text-small);
  }

  .legal-page h1 {
    font-size: var(--text-title);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .legal-page h2 {
    font-size: var(--text-base);
    font-weight: 600;
  }

  .legal-page section {
    display: grid;
    gap: var(--space-1);
    padding-top: var(--space-2);
    border-top: 1px solid var(--color-line);
  }
</style>
